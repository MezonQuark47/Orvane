{
  "kernel": {
    "id": "remote-da",
    "clientType": "remote"
  },
  "logging": {
    "level": "info",
    "format": "pretty"
  },
  "server": {
    "port": 3030,
    "dappPath": "/api/v0/dapp",
    "userPath": "/api/v0/user",
    "allowedOrigins": "*",
    "requestSizeLimit": "5mb",
    "requestRateLimit": 10000,
    "trustProxy": false,
    "admin": "operator",
    "signingWorker": {
      "pollInterval": 5000
    }
  },
  "signingProviders": {
    "walletKernel": {},
    "participant": {}
  },
  "signingStore": {
    "connection": {
      "type": "sqlite",
      "database": "/data/signing_store.sqlite"
    }
  },
  "store": {
    "connection": {
      "type": "sqlite",
      "database": "/data/store.sqlite"
    }
  },
  "idps": [
    {
      "id": "idp-localnet",
      "type": "self_signed",
      "issuer": "unsafe-auth"
    }
  ],
  "networks": [
    {
      "id": "canton:localnet",
      "name": "Canton LocalNet (app-user)",
      "description": "Splice LocalNet app-user validator",
      "identityProviderId": "idp-localnet",
      "auth": {
        "method": "self_signed",
        "issuer": "self-signed",
        "audience": "https://canton.network.global",
        "scope": "openid email daml_ledger_api offline_access",
        "clientId": "orvane-wallet",
        "clientSecretEnv": "LOCALNET_SECRET"
      },
      "adminAuth": {
        "method": "self_signed",
        "issuer": "self-signed",
        "audience": "https://canton.network.global",
        "scope": "daml_ledger_api",
        "clientId": "ledger-api-user",
        "clientSecretEnv": "LOCALNET_SECRET"
      },
      "ledgerApi": {
        "baseUrl": "http://host.docker.internal:2975"
      }
    }
  ],
  "hashingScheme": {
    "version": "HASHING_SCHEME_VERSION_V3"
  }
}