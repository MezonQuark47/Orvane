-- | The token-standard exchange, exercised with two CIP-56 instruments from
-- the Orvane registry. On LocalNet the same flow runs with Canton Coin.
module Test.ExchangeTest where

import DA.Assert
import DA.Optional (isNone)
import Daml.Script

import Splice.Api.Token.HoldingV1 (InstrumentId)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

import Orvane.Exchange
import Orvane.Math (getAmountOut)
import Test.RegistryTest

data Ex = Ex with
    r : Reg
    pool : ContractId ExchangePool

-- The venue is the pool operator and holds the reserves:
-- 10,000 USDx and 50,000 CCx (0.20 USDx per CCx).
exSetup : Script Ex
exSetup = do
  r <- regSetup
  _ <- mintTo r "USDx" r.venue 10000.0
  _ <- mintTo r "CCx" r.venue 50000.0
  pool <- submit r.venue do
    createCmd ExchangePool with
      operator = r.venue, poolId = "USDx-CCx"
      instrA = usdx r.admin, instrB = ccx r.admin
      reserveA = 10000.0, reserveB = 50000.0
      feeBps = 30.0, members = [r.alice, r.bob, r.carol]
  pure Ex with ..

placeSwap : Ex -> Party -> InstrumentId -> Decimal -> Decimal -> Text -> Script (ContractId ExchangeSwapRequest)
placeSwap ex trader instrument amount minOut ref = do
  let r = ex.r
  now <- getTime
  inputs <- map fst <$> holdingsOf trader instrument.id
  submit trader do
    createAndExerciseCmd
      (ExchangeSwapOrder with
        trader, operator = r.venue, poolId = "USDx-CCx"
        factoryCid = toInterfaceContractId @AllocationFactory r.rules
        expectedAdmin = r.admin
        allocation = AllocationSpecification with
          settlement = mkSettlement r now ref
          transferLegId = "in"
          transferLeg = TransferLeg with sender = trader, receiver = r.venue, amount, instrumentId = instrument, meta = emptyMeta
        requestedAt = now
        inputHoldingCids = inputs
        extraArgs = noArgs
        minOut)
      ExchangeSwapOrder_Place

-- The operator's side: allocate `amount` of the output from its reserves.
allocateOutput : Ex -> Party -> InstrumentId -> Decimal -> Text -> Script (ContractId Allocation)
allocateOutput ex trader instrument amount ref = do
  let r = ex.r
  now <- getTime
  reserves <- map fst <$> holdingsOf r.venue instrument.id
  allocate r (mkSettlement r now ref) "out" r.venue trader instrument amount reserves

emptyMeta = noArgs.meta

test_swapSettlesAtomically : Script ()
test_swapSettlesAtomically = do
  ex <- exSetup
  let r = ex.r
  _ <- mintTo r "USDx" r.bob 100.0
  let quote = getAmountOut 30.0 100.0 10000.0 50000.0
  req <- placeSwap ex r.bob (usdx r.admin) 100.0 (quote * 0.99) "swap-1"
  -- the trader's funds are locked, not yet moved
  bobUsd <- balanceOf r.bob "USDx"
  bobUsd === 0.0
  out <- allocateOutput ex r.bob (ccx r.admin) quote "swap-1"
  receipt <- submit r.venue do
    exerciseCmd req ExchangeSwapRequest_Settle with
      poolCid = ex.pool, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs
  bobCc <- balanceOf r.bob "CCx"
  bobCc === quote
  venueUsd <- balanceOf r.venue "USDx"
  venueUsd === 10100.0
  [(_, pool)] <- query @ExchangePool r.venue
  (pool.reserveA, pool.reserveB) === (10100.0, 50000.0 - quote)
  -- members see the new reserves, not the trade
  [(_, carolPool)] <- query @ExchangePool r.carol
  carolPool.reserveA === 10100.0
  carolReceipt <- queryContractId r.carol receipt
  carolReq <- queryContractId r.carol req
  assertMsg "carol must not see the trade" (isNone carolReceipt && isNone carolReq)

test_operatorCannotOverpayFromThePool : Script ()
test_operatorCannotOverpayFromThePool = do
  ex <- exSetup
  let r = ex.r
  _ <- mintTo r "USDx" r.bob 100.0
  let quote = getAmountOut 30.0 100.0 10000.0 50000.0
  req <- placeSwap ex r.bob (usdx r.admin) 100.0 0.0 "swap-2"
  out <- allocateOutput ex r.bob (ccx r.admin) (quote + 1.0) "swap-2"
  submitMustFail r.venue do
    exerciseCmd req ExchangeSwapRequest_Settle with
      poolCid = ex.pool, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs

test_slippageRejectReturnsFunds : Script ()
test_slippageRejectReturnsFunds = do
  ex <- exSetup
  let r = ex.r
  _ <- mintTo r "USDx" r.bob 100.0
  let quote = getAmountOut 30.0 100.0 10000.0 50000.0
  req <- placeSwap ex r.bob (usdx r.admin) 100.0 (quote + 5.0) "swap-3"
  out <- allocateOutput ex r.bob (ccx r.admin) quote "swap-3"
  submitMustFail r.venue do
    exerciseCmd req ExchangeSwapRequest_Settle with
      poolCid = ex.pool, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs
  -- the operator rejects: the trader's input is released
  submit r.venue do exerciseCmd req ExchangeSwapRequest_Reject with reason = "slippage", cancelArgs = noArgs
  bobUsd <- balanceOf r.bob "USDx"
  bobUsd === 100.0

test_mismatchedAllocationRejected : Script ()
test_mismatchedAllocationRejected = do
  ex <- exSetup
  let r = ex.r
  _ <- mintTo r "USDx" r.bob 100.0
  let quote = getAmountOut 30.0 100.0 10000.0 50000.0
  req <- placeSwap ex r.bob (usdx r.admin) 100.0 0.0 "swap-4"
  -- output allocated to the wrong receiver
  wrong <- allocateOutput ex r.carol (ccx r.admin) quote "swap-4"
  submitMustFail r.venue do
    exerciseCmd req ExchangeSwapRequest_Settle with
      poolCid = ex.pool, outputAllocationCid = wrong, inputExtraArgs = noArgs, outputExtraArgs = noArgs

test_orderMustPayTheOperator : Script ()
test_orderMustPayTheOperator = do
  ex <- exSetup
  let r = ex.r
  _ <- mintTo r "USDx" r.bob 100.0
  now <- getTime
  inputs <- map fst <$> holdingsOf r.bob "USDx"
  -- an order whose input goes to someone other than the operator
  submitMustFail r.bob do
    createAndExerciseCmd
      (ExchangeSwapOrder with
        trader = r.bob, operator = r.venue, poolId = "USDx-CCx"
        factoryCid = toInterfaceContractId @AllocationFactory r.rules
        expectedAdmin = r.admin
        allocation = AllocationSpecification with
          settlement = mkSettlement r now "x"
          transferLegId = "in"
          transferLeg = TransferLeg with sender = r.bob, receiver = r.carol, amount = 100.0, instrumentId = usdx r.admin, meta = emptyMeta
        requestedAt = now, inputHoldingCids = inputs, extraArgs = noArgs, minOut = 0.0)
      ExchangeSwapOrder_Place
