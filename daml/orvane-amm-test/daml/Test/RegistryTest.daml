-- | CIP-56 conformance-style tests for the Orvane registry. Everything is
-- driven through the standard interfaces, the way a wallet or another app
-- would use it.
module Test.RegistryTest where

import DA.Assert
import qualified DA.TextMap as TextMap
import DA.Optional (isNone, isSome)
import DA.Time (addRelTime, hours)
import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1
import Splice.Api.Token.TransferInstructionV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

import Orvane.Registry

data Reg = Reg with
    admin : Party
    alice : Party
    bob : Party
    carol : Party
    venue : Party
    rules : ContractId OrvaneRules

noArgs : ExtraArgs
noArgs = ExtraArgs (ChoiceContext TextMap.empty) emptyMetadata

usdx : Party -> InstrumentId
usdx admin = InstrumentId with admin; id = "USDx"

ccx : Party -> InstrumentId
ccx admin = InstrumentId with admin; id = "CCx"

regSetup : Script Reg
regSetup = do
  admin <- allocateParty "Registry"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  carol <- allocateParty "Carol"
  venue <- allocateParty "Venue"
  rules <- submit admin do
    createCmd OrvaneRules with admin, instruments = ["USDx", "CCx"], users = [alice, bob, carol, venue]
  pure Reg with ..

mintTo : Reg -> Text -> Party -> Decimal -> Script (ContractId Holding)
mintTo r instrument owner amount =
  submit r.admin do exerciseCmd r.rules OrvaneRules_Mint with instrument, owner, amount

holdingsOf : Party -> Text -> Script [(ContractId Holding, HoldingView)]
holdingsOf p instrument = do
  hs <- queryInterface @Holding p
  pure [(c, v) | (c, Some v) <- hs, v.owner == p, v.instrumentId.id == instrument]

balanceOf : Party -> Text -> Script Decimal
balanceOf p instrument = sum . map (\(_, v) -> v.amount) <$> holdingsOf p instrument

test_mintExposesHoldingView : Script ()
test_mintExposesHoldingView = do
  r <- regSetup
  _ <- mintTo r "USDx" r.alice 250.0
  [(_, v)] <- holdingsOf r.alice "USDx"
  (v.owner, v.instrumentId, v.amount, v.lock) === (r.alice, usdx r.admin, 250.0, None)

test_transferViaFactory : Script ()
test_transferViaFactory = do
  r <- regSetup
  h1 <- mintTo r "USDx" r.alice 60.0
  h2 <- mintTo r "USDx" r.alice 40.0
  now <- getTime
  result <- submit r.alice do
    exerciseCmd (toInterfaceContractId @TransferFactory r.rules) TransferFactory_Transfer with
      expectedAdmin = r.admin
      transfer = Transfer with
        sender = r.alice, receiver = r.bob, amount = 75.0
        instrumentId = usdx r.admin
        requestedAt = now, executeBefore = now `addRelTime` hours 1
        inputHoldingCids = [h1, h2]
        meta = emptyMetadata
      extraArgs = noArgs
  case result.output of
    TransferInstructionResult_Completed _ -> pure ()
    _ -> abort "expected a completed transfer"
  aliceBal <- balanceOf r.alice "USDx"
  bobBal <- balanceOf r.bob "USDx"
  (aliceBal, bobBal) === (25.0, 75.0)

test_transferInsufficientFunds : Script ()
test_transferInsufficientFunds = do
  r <- regSetup
  h <- mintTo r "USDx" r.alice 10.0
  now <- getTime
  submitMustFail r.alice do
    exerciseCmd (toInterfaceContractId @TransferFactory r.rules) TransferFactory_Transfer with
      expectedAdmin = r.admin
      transfer = Transfer with
        sender = r.alice, receiver = r.bob, amount = 11.0, instrumentId = usdx r.admin
        requestedAt = now, executeBefore = now `addRelTime` hours 1
        inputHoldingCids = [h], meta = emptyMetadata
      extraArgs = noArgs

-- | Cannot spend someone else's holding.
test_cannotSpendOthersHolding : Script ()
test_cannotSpendOthersHolding = do
  r <- regSetup
  h <- mintTo r "USDx" r.alice 10.0
  now <- getTime
  submitMustFail r.bob do
    exerciseCmd (toInterfaceContractId @TransferFactory r.rules) TransferFactory_Transfer with
      expectedAdmin = r.admin
      transfer = Transfer with
        sender = r.bob, receiver = r.bob, amount = 10.0, instrumentId = usdx r.admin
        requestedAt = now, executeBefore = now `addRelTime` hours 1
        inputHoldingCids = [h], meta = emptyMetadata
      extraArgs = noArgs

mkSettlement : Reg -> Time -> Text -> SettlementInfo
mkSettlement r now ref = SettlementInfo with
  executor = r.venue
  settlementRef = Reference with id = ref; cid = None
  requestedAt = now
  allocateBefore = now `addRelTime` hours 1
  settleBefore = now `addRelTime` hours 2
  meta = emptyMetadata

allocate : Reg -> SettlementInfo -> Text -> Party -> Party -> InstrumentId -> Decimal -> [ContractId Holding] -> Script (ContractId Allocation)
allocate r s legId sender receiver instrumentId amount inputs = do
  now <- getTime
  res <- submit sender do
    exerciseCmd (toInterfaceContractId @AllocationFactory r.rules) AllocationFactory_Allocate with
      expectedAdmin = r.admin
      allocation = AllocationSpecification with
        settlement = s
        transferLegId = legId
        transferLeg = TransferLeg with sender, receiver, amount, instrumentId, meta = emptyMetadata
      requestedAt = now
      inputHoldingCids = inputs
      extraArgs = noArgs
  case res.output of
    AllocationInstructionResult_Completed cid -> pure cid
    _ -> abort "expected a completed allocation"

-- | Delivery versus payment: alice pays 100 USDx, bob delivers 500 CCx,
-- the venue settles both legs atomically.
test_dvpSettlement : Script ()
test_dvpSettlement = do
  r <- regSetup
  usd <- mintTo r "USDx" r.alice 120.0
  cc <- mintTo r "CCx" r.bob 500.0
  now <- getTime
  let s = mkSettlement r now "trade-1"
  legA <- allocate r s "leg-usd" r.alice r.bob (usdx r.admin) 100.0 [usd]
  legB <- allocate r s "leg-cc" r.bob r.alice (ccx r.admin) 500.0 [cc]
  -- funds are escrowed: alice keeps only her change
  aliceUsd <- balanceOf r.alice "USDx"
  aliceUsd === 20.0
  -- an outsider sees neither leg
  carolA <- queryInterfaceContractId @Allocation r.carol legA
  assertMsg "carol must not see the allocation" (isNone carolA)
  venueA <- queryInterfaceContractId @Allocation r.venue legA
  assertMsg "the executor sees the allocation" (isSome venueA)
  -- settle both legs in one transaction (the venue acts with both traders'
  -- authority, as an app contract signed by the traders would)
  submit (actAs [r.venue, r.alice, r.bob]) $
    exerciseCmd legA Allocation_ExecuteTransfer with extraArgs = noArgs
      *> exerciseCmd legB Allocation_ExecuteTransfer with extraArgs = noArgs
      *> pure ()
  aliceCc <- balanceOf r.alice "CCx"
  bobUsd <- balanceOf r.bob "USDx"
  (aliceCc, bobUsd) === (500.0, 100.0)

test_executorAloneCannotSettle : Script ()
test_executorAloneCannotSettle = do
  r <- regSetup
  usd <- mintTo r "USDx" r.alice 100.0
  now <- getTime
  leg <- allocate r (mkSettlement r now "t") "leg" r.alice r.bob (usdx r.admin) 100.0 [usd]
  submitMustFail r.venue do exerciseCmd leg Allocation_ExecuteTransfer with extraArgs = noArgs

test_senderCanWithdraw : Script ()
test_senderCanWithdraw = do
  r <- regSetup
  usd <- mintTo r "USDx" r.alice 100.0
  now <- getTime
  leg <- allocate r (mkSettlement r now "t") "leg" r.alice r.bob (usdx r.admin) 100.0 [usd]
  _ <- submit r.alice do exerciseCmd leg Allocation_Withdraw with extraArgs = noArgs
  bal <- balanceOf r.alice "USDx"
  bal === 100.0

test_settlementDeadline : Script ()
test_settlementDeadline = do
  r <- regSetup
  usd <- mintTo r "USDx" r.alice 100.0
  now <- getTime
  leg <- allocate r (mkSettlement r now "t") "leg" r.alice r.bob (usdx r.admin) 100.0 [usd]
  passTime (hours 3)
  submitMustFail (actAs [r.venue, r.alice, r.bob]) do
    exerciseCmd leg Allocation_ExecuteTransfer with extraArgs = noArgs
  -- the sender can still get their money back
  _ <- submit r.alice do exerciseCmd leg Allocation_Withdraw with extraArgs = noArgs
  bal <- balanceOf r.alice "USDx"
  bal === 100.0
