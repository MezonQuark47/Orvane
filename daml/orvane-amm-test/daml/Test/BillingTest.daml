module Test.BillingTest where

import DA.Assert
import DA.Date (Month(..), date)
import DA.Optional (isNone)
import Daml.Script

import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

import Orvane.Billing
import Orvane.Exchange
import Orvane.Pay.Util (getAmountIn)
import Orvane.Registry
import Test.ExchangeTest
import Test.RegistryTest
import Test.TreasuryTest (Pay(..), paySetup)

-- Carol supplies, Acme buys. Bob is an outsider.
billTerms : Pay -> Decimal -> BillTerms
billTerms p amt = BillTerms with
  invoiceNo = "NOVA-1041", memo = "Warehouse racking", amount = amt
  instrument = usdx p.ex.r.admin, dueDate = date 2026 Dec 18

invoice : Pay -> Decimal -> Script (ContractId InvoiceCn)
invoice p amt = submit p.ex.r.carol do createCmd InvoiceCn with supplier = p.ex.r.carol, buyer = p.acme, terms = billTerms p amt

-- settlement executed by the buyer
buyerSettlement : Pay -> Time -> Text -> SettlementInfo
buyerSettlement p now ref = (mkSettlement p.ex.r now ref) with executor = p.acme

test_invoicePaidDirectly : Script ()
test_invoicePaidDirectly = do
  p <- paySetup
  let r = p.ex.r
  inv <- invoice p 1200.0
  bobSees <- queryContractId r.bob inv
  opSees <- queryContractId r.venue inv
  assertMsg "only supplier and buyer see the invoice" (isNone bobSees && isNone opSees)
  now <- getTime
  inputs <- map fst <$> holdingsOf p.acme "USDx"
  payment <- submit p.acme do
    exerciseCmd inv InvoiceCn_Lock with
      factoryCid = toInterfaceContractId @AllocationFactory p.rules
      allocation = AllocationSpecification with
        settlement = buyerSettlement p now "inv-1"
        transferLegId = "pay"
        transferLeg = TransferLeg with sender = p.acme, receiver = r.carol, amount = 1200.0, instrumentId = usdx r.admin, meta = emptyMeta
      requestedAt = now, inputHoldingCids = inputs, extraArgs = noArgs
  carolBefore <- balanceOf r.carol "USDx"
  carolBefore === 0.0
  paid <- submit p.acme do exerciseCmd payment InvoicePaymentCn_Settle with extraArgs = noArgs
  carolUsd <- balanceOf r.carol "USDx"
  carolUsd === 1200.0
  Some pi <- queryContractId r.carol paid
  pi.converted === False

test_lockedPaymentCanBeCancelled : Script ()
test_lockedPaymentCanBeCancelled = do
  p <- paySetup
  let r = p.ex.r
  inv <- invoice p 1200.0
  now <- getTime
  inputs <- map fst <$> holdingsOf p.acme "USDx"
  payment <- submit p.acme do
    exerciseCmd inv InvoiceCn_Lock with
      factoryCid = toInterfaceContractId @AllocationFactory p.rules
      allocation = AllocationSpecification with
        settlement = buyerSettlement p now "inv-2"
        transferLegId = "pay"
        transferLeg = TransferLeg with sender = p.acme, receiver = r.carol, amount = 1200.0, instrumentId = usdx r.admin, meta = emptyMeta
      requestedAt = now, inputHoldingCids = inputs, extraArgs = noArgs
  reopened <- submit p.acme do exerciseCmd payment InvoicePaymentCn_Cancel with extraArgs = noArgs
  acmeUsd <- balanceOf p.acme "USDx"
  acmeUsd === 10000.0
  Some _ <- queryContractId p.acme reopened
  pure ()

payConverted : Pay -> ContractId InvoiceCn -> Decimal -> Text -> Script (ContractId InvoiceConversionCn)
payConverted p inv amountIn ref = do
  let r = p.ex.r
  now <- getTime
  inputs <- map fst <$> holdingsOf p.acme "CCx"
  submit p.acme do
    exerciseCmd inv InvoiceCn_PayConverted with
      operator = r.venue, poolId = "USDx-CCx"
      factoryCid = toInterfaceContractId @AllocationFactory p.rules, expectedAdmin = r.admin
      allocation = AllocationSpecification with
        settlement = mkSettlement r now ref
        transferLegId = "in"
        transferLeg = TransferLeg with sender = p.acme, receiver = r.venue, amount = amountIn, instrumentId = ccx r.admin, meta = emptyMeta
      requestedAt = now, inputHoldingCids = inputs, extraArgs = noArgs

test_invoicePaidInAnotherAsset : Script ()
test_invoicePaidInAnotherAsset = do
  p <- paySetup
  let r = p.ex.r
  _ <- submit r.admin do exerciseCmd p.rules OrvaneRules_Mint with instrument = "CCx", owner = p.acme, amount = 10000.0
  inv <- invoice p 1200.0
  let needIn = getAmountIn 30.0 1200.0 50000.0 10000.0
      amountIn = needIn * 1.003
  conv <- payConverted p inv amountIn "inv-3"
  -- the operator pays exactly the invoiced USDx from the pool's reserves
  out <- allocateOutput p.ex r.carol (usdx r.admin) 1200.0 "inv-3"
  paid <- submit r.venue do
    exerciseCmd conv InvoiceConversionCn_Settle with
      poolCid = p.ex.pool, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs
  carolUsd <- balanceOf r.carol "USDx"
  carolUsd === 1200.0
  acmeCc <- balanceOf p.acme "CCx"
  acmeCc === 10000.0 - amountIn
  Some pi <- queryContractId p.acme paid
  (pi.converted, pi.paidAmount) === (True, amountIn)
  [(_, pool)] <- query @ExchangePool r.venue
  (pool.reserveA, pool.reserveB) === (10000.0 - 1200.0, 50000.0 + amountIn)

test_conversionTooSmallIsRejected : Script ()
test_conversionTooSmallIsRejected = do
  p <- paySetup
  let r = p.ex.r
  _ <- submit r.admin do exerciseCmd p.rules OrvaneRules_Mint with instrument = "CCx", owner = p.acme, amount = 10000.0
  inv <- invoice p 1200.0
  conv <- payConverted p inv 100.0 "inv-4"
  out <- allocateOutput p.ex r.carol (usdx r.admin) 1200.0 "inv-4"
  submitMustFail r.venue do
    exerciseCmd conv InvoiceConversionCn_Settle with
      poolCid = p.ex.pool, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs
  reopened <- submit r.venue do exerciseCmd conv InvoiceConversionCn_Reject with reason = "too small", cancelArgs = noArgs
  acmeCc <- balanceOf p.acme "CCx"
  acmeCc === 10000.0
  Some _ <- queryContractId p.acme reopened
  pure ()

test_disputeAndReissue : Script ()
test_disputeAndReissue = do
  p <- paySetup
  inv <- invoice p 1200.0
  d <- submit p.acme do exerciseCmd inv InvoiceCn_Dispute with reason = "90 units, not 100"
  fixed <- submit p.ex.r.carol do
    exerciseCmd d DisputedInvoiceCn_Reissue with newTerms = (billTerms p 1080.0) with invoiceNo = "NOVA-1041-R1"
  Some i <- queryContractId p.acme fixed
  (i.terms.invoiceNo, i.terms.amount) === ("NOVA-1041-R1", 1080.0)
