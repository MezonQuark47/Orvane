-- | Adding and removing liquidity on the token-standard exchange pool.
module Test.LiquidityTest where

import DA.Assert
import DA.Optional (isNone)
import Daml.Script

import Splice.Api.Token.HoldingV1 (InstrumentId)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1 (AllocationFactory)

import Orvane.Exchange
import Orvane.Liquidity
import Orvane.Math (getAmountOut, sqrtDecimal)
import Test.ExchangeTest (Ex(..), allocateOutput, emptyMeta, exSetup, placeSwap)
import Test.RegistryTest

data Lp = Lp with
    ex : Ex
    book : ContractId LpBook

-- The venue seeded the pool, so it holds the first share.
lpSetup : Script Lp
lpSetup = do
  ex <- exSetup
  let r = ex.r
      initial = sqrtDecimal (10000.0 * 50000.0)
  book <- submit r.venue do createCmd LpBook with operator = r.venue, poolId = "USDx-CCx", totalShares = initial, members = [r.alice, r.bob, r.carol]
  _ <- submit r.venue do createCmd LpShare with operator = r.venue, owner = r.venue, poolId = "USDx-CCx", shares = initial
  pure Lp with ..

side : Reg -> Party -> InstrumentId -> Decimal -> Text -> Text -> Script Side
side r provider instrument amount ref legId = do
  now <- getTime
  inputs <- map fst <$> holdingsOf provider instrument.id
  pure Side with
    factoryCid = toInterfaceContractId @AllocationFactory r.rules
    expectedAdmin = r.admin
    allocation = AllocationSpecification with
      settlement = mkSettlement r now ref
      transferLegId = legId
      transferLeg = TransferLeg with sender = provider, receiver = r.venue, amount, instrumentId = instrument, meta = emptyMeta
    requestedAt = now
    inputHoldingCids = inputs
    extraArgs = noArgs

placeDeposit : Lp -> Party -> Decimal -> Decimal -> Decimal -> Text -> Script (ContractId LpDepositRequest)
placeDeposit lp provider amountA amountB minShares ref = do
  let r = lp.ex.r
  a <- side r provider (usdx r.admin) amountA ref "a"
  b <- side r provider (ccx r.admin) amountB ref "b"
  submit provider do
    createAndExerciseCmd
      (LpDepositOrder with provider, operator = r.venue, poolId = "USDx-CCx", sideA = a, sideB = b, minShares)
      LpDepositOrder_Place

settleDeposit : Lp -> ContractId LpDepositRequest -> Script (ContractId LpShare)
settleDeposit lp req = do
  let r = lp.ex.r
  [(pool, _)] <- query @ExchangePool r.venue
  [(book, _)] <- query @LpBook r.venue
  submit r.venue do
    exerciseCmd req LpDepositRequest_Settle with poolCid = pool, bookCid = book, extraArgsA = noArgs, extraArgsB = noArgs

test_depositMintsAProportionalShare : Script ()
test_depositMintsAProportionalShare = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  [(_, before)] <- query @LpBook r.venue
  req <- placeDeposit lp r.alice 1000.0 5000.0 0.0 "lp-1"
  -- funds are locked, not yet in the pool
  aliceUsd <- balanceOf r.alice "USDx"
  aliceUsd === 0.0
  shareCid <- settleDeposit lp req
  Some share <- queryContractId r.alice shareCid
  -- 10% more liquidity, 10% more shares
  share.shares === before.totalShares * 0.1
  [(_, pool)] <- query @ExchangePool r.venue
  (pool.reserveA, pool.reserveB) === (11000.0, 55000.0)
  [(_, after)] <- query @LpBook r.venue
  after.totalShares === before.totalShares * 1.1
  -- members see the deeper pool, not who made it so
  [(_, carolPool)] <- query @ExchangePool r.carol
  carolPool.reserveA === 11000.0
  carolShare <- queryContractId r.carol shareCid
  assertMsg "carol must not see alice's share" (isNone carolShare)
  [(_, carolBook)] <- query @LpBook r.carol
  carolBook.totalShares === after.totalShares

test_withdrawPaysTheShareOfBothReserves : Script ()
test_withdrawPaysTheShareOfBothReserves = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  shareCid <- settleDeposit lp =<< placeDeposit lp r.alice 1000.0 5000.0 0.0 "lp-2"
  -- a trade lands in between: its fee stays in the reserves
  _ <- mintTo r "USDx" r.bob 500.0
  let quote = getAmountOut 30.0 500.0 11000.0 55000.0
  swap <- placeSwap lp.ex r.bob (usdx r.admin) 500.0 0.0 "swap-lp"
  out <- allocateOutput lp.ex r.bob (ccx r.admin) quote "swap-lp"
  [(pool0, _)] <- query @ExchangePool r.venue
  _ <- submit r.venue do
    exerciseCmd swap ExchangeSwapRequest_Settle with poolCid = pool0, outputAllocationCid = out, inputExtraArgs = noArgs, outputExtraArgs = noArgs
  [(poolCid, pool)] <- query @ExchangePool r.venue
  [(bookCid, book)] <- query @LpBook r.venue
  Some share <- queryContractId r.alice shareCid
  let fraction = share.shares / book.totalShares
      owedA = pool.reserveA * fraction
      owedB = pool.reserveB * fraction
  req <- submit r.alice do createCmd LpWithdrawRequest with provider = r.alice, operator = r.venue, shareCid, minA = 0.0, minB = 0.0
  payA <- allocateOutput lp.ex r.alice (usdx r.admin) owedA "lp-out"
  payB <- allocateOutput lp.ex r.alice (ccx r.admin) owedB "lp-out"
  submit r.venue do
    exerciseCmd req LpWithdrawRequest_Settle with
      poolCid, bookCid, payoutA = payA, payoutB = payB, ref = "lp-out", extraArgsA = noArgs, extraArgsB = noArgs
  aliceUsd <- balanceOf r.alice "USDx"
  aliceCc <- balanceOf r.alice "CCx"
  -- the share's value moved with the trade: more USDx, less CCx, and the
  -- fee means the pool's k grew for her
  aliceUsd === owedA
  aliceCc === owedB
  assertMsg "alice earned part of the fee" (aliceUsd * aliceCc > 1000.0 * 5000.0)
  gone <- queryContractId r.alice shareCid
  assertMsg "the share is burned" (isNone gone)
  [(_, after)] <- query @ExchangePool r.venue
  (after.reserveA, after.reserveB) === (pool.reserveA - owedA, pool.reserveB - owedB)

test_operatorCannotOverpayAWithdrawal : Script ()
test_operatorCannotOverpayAWithdrawal = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  shareCid <- settleDeposit lp =<< placeDeposit lp r.alice 1000.0 5000.0 0.0 "lp-3"
  [(poolCid, _)] <- query @ExchangePool r.venue
  [(bookCid, _)] <- query @LpBook r.venue
  req <- submit r.alice do createCmd LpWithdrawRequest with provider = r.alice, operator = r.venue, shareCid, minA = 0.0, minB = 0.0
  payA <- allocateOutput lp.ex r.alice (usdx r.admin) 1500.0 "lp-over"
  payB <- allocateOutput lp.ex r.alice (ccx r.admin) 5000.0 "lp-over"
  submitMustFail r.venue do
    exerciseCmd req LpWithdrawRequest_Settle with
      poolCid, bookCid, payoutA = payA, payoutB = payB, ref = "lp-over", extraArgsA = noArgs, extraArgsB = noArgs
  -- and the provider can take the request back
  submit r.alice do exerciseCmd req LpWithdrawRequest_Cancel
  stillThere <- queryContractId r.alice shareCid
  assertMsg "the share is untouched" (stillThere /= None)

test_depositRejectReturnsBothSides : Script ()
test_depositRejectReturnsBothSides = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  -- asks for far more shares than the deposit is worth
  req <- placeDeposit lp r.alice 1000.0 5000.0 1000000.0 "lp-4"
  [(poolCid, _)] <- query @ExchangePool r.venue
  [(bookCid, _)] <- query @LpBook r.venue
  submitMustFail r.venue do
    exerciseCmd req LpDepositRequest_Settle with poolCid, bookCid, extraArgsA = noArgs, extraArgsB = noArgs
  submit r.venue do exerciseCmd req LpDepositRequest_Reject with reason = "slippage", cancelArgsA = noArgs, cancelArgsB = noArgs
  aliceUsd <- balanceOf r.alice "USDx"
  aliceCc <- balanceOf r.alice "CCx"
  (aliceUsd, aliceCc) === (1000.0, 5000.0)

test_depositMustPayTheOperator : Script ()
test_depositMustPayTheOperator = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  a <- side r r.alice (usdx r.admin) 1000.0 "lp-5" "a"
  b <- side r r.alice (ccx r.admin) 5000.0 "lp-5" "b"
  -- side B is routed to carol instead of the operator
  let leg = b.allocation.transferLeg
      bad = b with allocation = b.allocation with transferLeg = leg with receiver = r.carol
  submitMustFail r.alice do
    createAndExerciseCmd
      (LpDepositOrder with provider = r.alice, operator = r.venue, poolId = "USDx-CCx", sideA = a, sideB = bad, minShares = 0.0)
      LpDepositOrder_Place

test_depositMustMatchThePair : Script ()
test_depositMustMatchThePair = do
  lp <- lpSetup
  let r = lp.ex.r
  _ <- mintTo r "USDx" r.alice 1000.0
  _ <- mintTo r "CCx" r.alice 5000.0
  -- sides swapped: CCx where the pool expects USDx
  a <- side r r.alice (ccx r.admin) 5000.0 "lp-6" "a"
  b <- side r r.alice (usdx r.admin) 1000.0 "lp-6" "b"
  req <- submit r.alice do
    createAndExerciseCmd
      (LpDepositOrder with provider = r.alice, operator = r.venue, poolId = "USDx-CCx", sideA = a, sideB = b, minShares = 0.0)
      LpDepositOrder_Place
  [(poolCid, _)] <- query @ExchangePool r.venue
  [(bookCid, _)] <- query @LpBook r.venue
  submitMustFail r.venue do
    exerciseCmd req LpDepositRequest_Settle with poolCid, bookCid, extraArgsA = noArgs, extraArgsB = noArgs
