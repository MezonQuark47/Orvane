module Test.LendingTest where

import DA.Assert
import DA.Optional (isNone, isSome)
import DA.Time (hours)
import Daml.Script

import Orvane.Advance
import Orvane.Amm
import Orvane.Lending
import Orvane.Math (getAmountOut)
import Orvane.Payroll
import Orvane.Token
import Test.AmmTest (mint)
import Test.PaymentsTest (Biz(..), balance, bizSetup)

data Mkt = Mkt with
    b : Biz
    marketCid : ContractId LendingMarket

-- | A USDx/CCx market priced by the test pool (0.20 USDx per CCx), on a demo
-- clock where one year lasts one hour. Alice supplies 50,000 USDx.
marketSetup : Script Mkt
marketSetup = do
  b <- bizSetup
  let w = b.w
  m0 <- submit w.operator do
    createCmd LendingMarket with
      operator = w.operator, marketId = "USDx-lend"
      assetIssuer = w.usdIssuer, assetSymbol = "USDx"
      collIssuer = w.ccIssuer, collSymbol = "CCx"
      poolId = "USDx-CCx"
      cash = 0.0, cashHoldings = [], principalOut = 0.0, totalShares = 0.0
      baseAprBps = 200.0, slopeAprBps = 1800.0
      maxLtvBps = 6000.0, liqLtvBps = 8000.0
      yearSeconds = 3600, badDebt = 0.0
      members = [w.alice, w.bob, w.carol, b.acme, b.nova]
  usd <- mint w.usdIssuer w.alice "USDx" 50000.0
  req <- submit w.alice do
    createAndExerciseCmd
      (SupplyOrder with lender = w.alice, operator = w.operator, marketId = "USDx-lend", holdings = [usd], amount = 50000.0)
      SupplyOrder_Place
  _ <- submit w.operator do exerciseCmd req SupplyRequest_Execute with marketCid = m0
  [(m, _)] <- query @LendingMarket w.operator
  pure Mkt with b, marketCid = m

currentMarket : Mkt -> Script (ContractId LendingMarket, LendingMarket)
currentMarket m = do
  [r] <- query @LendingMarket m.b.w.operator
  pure r

borrow : Mkt -> Decimal -> Decimal -> Script (ContractId Loan)
borrow m coll amount = do
  let w = m.b.w
  cc <- mint w.ccIssuer m.b.acme "CCx" coll
  req <- submit m.b.acme do
    createAndExerciseCmd
      (BorrowOrder with
        borrower = m.b.acme, operator = w.operator, marketId = "USDx-lend"
        holdings = [cc], collateralAmount = coll, borrowAmount = amount)
      BorrowOrder_Place
  (mc, _) <- currentMarket m
  submit w.operator do exerciseCmd req BorrowRequest_Execute with marketCid = mc, poolCid = w.poolCid

test_supplyAndBorrowPrivately : Script ()
test_supplyAndBorrowPrivately = do
  m <- marketSetup
  let w = m.b.w
  -- 10,000 CCx at 0.20 = 2,000 USDx of collateral; 60% max LTV = 1,200
  loan <- borrow m 10000.0 1150.0
  acmeUsd <- balance m.b.acme w.usdIssuer "USDx"
  acmeUsd === 1150.0
  (_, mkt) <- currentMarket m
  (mkt.cash, mkt.principalOut) === (48850.0, 1150.0)
  -- members see the market totals, but not the loan or who took it
  [(_, carolView)] <- query @LendingMarket w.carol
  carolView.principalOut === 1150.0
  carolLoan <- queryContractId w.carol loan
  assertMsg "carol must not see acme's loan" (isNone carolLoan)
  aliceLoan <- queryContractId w.alice loan
  assertMsg "the lender must not see who borrowed" (isNone aliceLoan)
  acmeLoan <- queryContractId m.b.acme loan
  assertMsg "the borrower sees their loan" (isSome acmeLoan)

test_borrowAboveLimitRejected : Script ()
test_borrowAboveLimitRejected = do
  m <- marketSetup
  let w = m.b.w
  cc <- mint w.ccIssuer m.b.acme "CCx" 10000.0
  req <- submit m.b.acme do
    createAndExerciseCmd
      (BorrowOrder with
        borrower = m.b.acme, operator = w.operator, marketId = "USDx-lend"
        holdings = [cc], collateralAmount = 10000.0, borrowAmount = 1201.0)
      BorrowOrder_Place
  (mc, _) <- currentMarket m
  submitMustFail w.operator do exerciseCmd req BorrowRequest_Execute with marketCid = mc, poolCid = w.poolCid

test_repayWithInterestAndLenderEarns : Script ()
test_repayWithInterestAndLenderEarns = do
  m <- marketSetup
  let w = m.b.w
  loanCid <- borrow m 10000.0 1000.0
  Some loan <- queryContractId m.b.acme loanCid
  passTime (hours 1) -- one demo year
  let owed = 1000.0 + 1000.0 * loan.aprBps / 10000.0
  extra <- mint w.usdIssuer m.b.acme "USDx" 500.0
  usd <- query @Token m.b.acme
  let holdings = [c | (c, t) <- usd, t.owner == m.b.acme, t.symbol == "USDx"]
  (mc, _) <- currentMarket m
  closed <- submit m.b.acme do exerciseCmd loanCid Loan_Repay with holdings, marketCid = mc
  Some c <- queryContractId m.b.acme closed
  c.interest === owed - 1000.0
  -- collateral is back, privately
  acmeCc <- balance m.b.acme w.ccIssuer "CCx"
  acmeCc === 10000.0
  acmeUsd <- balance m.b.acme w.usdIssuer "USDx"
  acmeUsd === 1500.0 - owed
  _ <- pure extra
  -- the lender withdraws principal plus the interest
  [(pos, p)] <- query @SupplyPosition w.alice
  wreq <- submit w.alice do createCmd WithdrawSupplyRequest with lender = w.alice, operator = w.operator, positionCid = pos
  (mc2, _) <- currentMarket m
  _ <- submit w.operator do exerciseCmd wreq WithdrawSupplyRequest_Execute with marketCid = mc2
  aliceUsd <- balance w.alice w.usdIssuer "USDx"
  aliceUsd === 50000.0 + (owed - 1000.0)
  _ <- pure p
  pure ()

test_healthyLoanCannotBeLiquidated : Script ()
test_healthyLoanCannotBeLiquidated = do
  m <- marketSetup
  loan <- borrow m 10000.0 1150.0
  (mc, _) <- currentMarket m
  submitMustFail m.b.w.operator do exerciseCmd loan Loan_Liquidate with marketCid = mc, poolCid = m.b.w.poolCid

test_liquidationThroughThePool : Script ()
test_liquidationThroughThePool = do
  m <- marketSetup
  let w = m.b.w
  loan <- borrow m 10000.0 1150.0
  -- bob dumps 30,000 CCx; the price falls from 0.20 to ~0.078
  cc <- mint w.ccIssuer w.bob "CCx" 30000.0
  cc' <- submit w.bob do exerciseCmd cc Disclose with party = w.operator
  sreq <- submit w.bob do
    createCmd SwapRequest with trader = w.bob, operator = w.operator, poolId = "USDx-CCx", inputCid = cc', minOutput = 0.0
  (poolCid, _, _) <- submit w.operator do exerciseCmd sreq SwapRequest_Execute with poolCid = w.poolCid
  Some pool <- queryContractId w.operator poolCid
  let expectedProceeds = getAmountOut 30.0 10000.0 pool.reserveB pool.reserveA
  (mc, _) <- currentMarket m
  closed <- submit w.operator do exerciseCmd loan Loan_Liquidate with marketCid = mc, poolCid
  Some c <- queryContractId m.b.acme closed
  c.liquidated === True
  (_, mkt) <- currentMarket m
  mkt.principalOut === 0.0
  -- proceeds didn't cover the debt: the shortfall is recorded, not hidden
  mkt.badDebt === 1150.0 - expectedProceeds
  mkt.cash === 48850.0 + expectedProceeds

test_addCollateral : Script ()
test_addCollateral = do
  m <- marketSetup
  let w = m.b.w
  loan <- borrow m 10000.0 1150.0
  more <- mint w.ccIssuer m.b.acme "CCx" 5000.0
  loan' <- submit m.b.acme do exerciseCmd loan Loan_AddCollateral with holdings = [more], amount = 5000.0
  Some l <- queryContractId m.b.acme loan'
  l.collateralAmount === 15000.0

openLine : Mkt -> Script (ContractId AdvanceLine)
openLine m = do
  let w = m.b.w
  submit m.b.acme do
    createCmd AdvanceLine with
      employer = m.b.acme, employee = w.bob, operator = w.operator, marketId = "USDx-lend"
      limit = 1250.0, feeBps = 100.0, drawn = 0.0

drawAdvance : Mkt -> ContractId AdvanceLine -> Decimal -> Script (ContractId Advance)
drawAdvance m line amount = do
  let w = m.b.w
  req <- submit w.bob do createCmd AdvanceRequest with employee = w.bob, operator = w.operator, lineCid = line, amount
  (mc, _) <- currentMarket m
  submit w.operator do exerciseCmd req AdvanceRequest_Execute with marketCid = mc

test_advanceRepaidFromPayroll : Script ()
test_advanceRepaidFromPayroll = do
  m <- marketSetup
  let w = m.b.w
  line <- openLine m
  adv <- drawAdvance m line 800.0
  bobUsd <- balance w.bob w.usdIssuer "USDx"
  bobUsd === 800.0
  -- the employer sees the advance; colleagues and the lender don't
  Some _ <- queryContractId m.b.acme adv
  aliceSees <- queryContractId w.alice adv
  carolSees <- queryContractId w.carol adv
  assertMsg "colleagues must not see the advance" (isNone aliceSees && isNone carolSees)

  funds <- mint w.usdIssuer m.b.acme "USDx" 10000.0
  [(lineNow, _)] <- query @AdvanceLine m.b.acme
  (mc, _) <- currentMarket m
  let pay who amt = PayLine with employee = who, amount = amt, receiveSymbol = "USDx", minReceive = 0.0
  att <- submit m.b.acme do
    createAndExerciseCmd
      (PayrollWithAdvances with
        employer = m.b.acme, operator = w.operator, poolId = "USDx-CCx", auditors = [m.b.auditor]
        runId = "2026-11", period = "November 2026"
        issuer = w.usdIssuer, symbol = "USDx", holdings = [funds]
        lines = [pay w.alice 3000.0, pay w.bob 2500.0, pay w.carol 4200.0]
        advances = [AdvanceToSettle with advanceCid = adv, lineCid = lineNow]
        marketCid = mc)
      PayrollWithAdvances_Run
  -- bob gets his pay minus the advance and its 1% fee
  bobAfter <- balance w.bob w.usdIssuer "USDx"
  bobAfter === 800.0 + (2500.0 - 808.0)
  [(_, slip)] <- query @Payslip w.bob
  slip.received === 1692.0
  -- the market got principal + fee back
  (_, mkt) <- currentMarket m
  (mkt.cash, mkt.principalOut) === (50008.0, 0.0)
  -- the line is free again and the auditor still only sees totals
  [(_, l)] <- query @AdvanceLine m.b.acme
  l.drawn === 0.0
  Some a <- queryContractId m.b.auditor att
  a.total === 9700.0 - 808.0
  auditorAdvances <- query @AdvanceRepaid m.b.auditor
  length auditorAdvances === 0

test_advanceLimits : Script ()
test_advanceLimits = do
  m <- marketSetup
  let w = m.b.w
  line <- openLine m
  -- above the limit
  req <- submit w.bob do createCmd AdvanceRequest with employee = w.bob, operator = w.operator, lineCid = line, amount = 1300.0
  (mc, _) <- currentMarket m
  submitMustFail w.operator do exerciseCmd req AdvanceRequest_Execute with marketCid = mc
  -- one open advance at a time
  _ <- drawAdvance m line 500.0
  [(lineNow, _)] <- query @AdvanceLine m.b.acme
  req2 <- submit w.bob do createCmd AdvanceRequest with employee = w.bob, operator = w.operator, lineCid = lineNow, amount = 100.0
  (mc2, _) <- currentMarket m
  submitMustFail w.operator do exerciseCmd req2 AdvanceRequest_Execute with marketCid = mc2
