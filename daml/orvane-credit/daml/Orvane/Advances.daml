-- | Earned-wage advances on the token standard, funded by the credit market.
--
--   * The employer opens an AdvanceLineCn per employee and stands behind it.
--   * The employee draws: the operator pays USDx from the market through an
--     allocation (operator -> employee) and records an AdvanceCn.
--   * On payday the employer repays principal + fee to the market with an
--     allocation, in the same transaction that releases payroll.
--
-- Colleagues and lenders never see who took an advance; market members see
-- cash going out and coming back.
module Orvane.Advances where

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.AllocationV1

import Orvane.Credit (CreditMarket(..), Credit_Lend(..), Credit_Receive(..))
import Orvane.Math (bpsDenominator)

template AdvanceLineCn
  with
    employer : Party
    employee : Party
    operator : Party
    marketId : Text
    limit    : Decimal
    feeBps   : Decimal
    drawn    : Decimal
  where
    signatory employer
    observer employee, operator
    ensure limit >= 0.0 && drawn >= 0.0 && drawn <= limit && feeBps >= 0.0

    choice AdvanceLineCn_SetLimit : ContractId AdvanceLineCn
      with
        newLimit : Decimal
      controller employer
      do create this with limit = max newLimit drawn

    choice AdvanceLineCn_Draw : ContractId AdvanceLineCn
      with
        amount : Decimal
      controller operator
      do create this with drawn = drawn + amount

    choice AdvanceLineCn_Restore : ContractId AdvanceLineCn
      with
        amount : Decimal
      controller operator
      do create this with drawn = max 0.0 (drawn - amount)

template AdvanceRequestCn
  with
    employee : Party
    operator : Party
    lineCid  : ContractId AdvanceLineCn
    amount   : Decimal
  where
    signatory employee
    observer operator
    ensure amount > 0.0

    -- | Pay the advance: `payoutAllocationCid` is operator -> employee for `amount`.
    choice AdvanceRequestCn_Settle : ContractId AdvanceCn
      with
        marketCid           : ContractId CreditMarket
        payoutAllocationCid : ContractId Allocation
        extraArgs           : ExtraArgs
      controller operator
      do
        line <- fetch lineCid
        market <- fetch marketCid
        assertMsg "line does not belong to this employee" (line.employee == employee && line.operator == operator)
        assertMsg "wrong market" (market.marketId == line.marketId && market.operator == operator)
        assertMsg "one open advance per pay period" (line.drawn == 0.0)
        assertMsg "above the advance limit" (amount <= line.limit)
        v <- view <$> fetch payoutAllocationCid
        let leg = v.allocation.transferLeg
        assertMsg "payout allocation does not match"
          (leg.sender == operator && leg.receiver == employee && v.allocation.settlement.executor == operator
            && leg.instrumentId == market.asset && leg.amount == amount)
        _ <- exercise lineCid AdvanceLineCn_Draw with amount
        _ <- exercise marketCid Credit_Lend with amount
        _ <- exercise payoutAllocationCid Allocation_ExecuteTransfer with extraArgs
        now <- getTime
        create AdvanceCn with
          operator, employee, employer = line.employer, marketId = line.marketId
          principal = amount, fee = amount * line.feeBps / bpsDenominator, drawnAt = now

    choice AdvanceRequestCn_Reject : ()
      with
        reason : Text
      controller operator
      do pure ()

-- | An outstanding advance. The employer sees it so it can be repaid at payroll.
template AdvanceCn
  with
    operator  : Party
    employee  : Party
    employer  : Party
    marketId  : Text
    principal : Decimal
    fee       : Decimal
    drawnAt   : Time
  where
    signatory operator, employee
    observer employer

    -- | Repay from the employer's treasury. `allocationCid` is
    -- employer -> operator for principal + fee, executed by the employer.
    choice AdvanceCn_Repay : ContractId AdvanceRepaidCn
      with
        allocationCid : ContractId Allocation
        marketCid     : ContractId CreditMarket
        lineCid       : ContractId AdvanceLineCn
        extraArgs     : ExtraArgs
        period        : Text
      controller employer
      do
        market <- fetch marketCid
        line <- fetch lineCid
        assertMsg "line does not match" (line.employee == employee && line.employer == employer)
        v <- view <$> fetch allocationCid
        let leg = v.allocation.transferLeg
        assertMsg "repayment allocation does not match"
          (leg.sender == employer && leg.receiver == operator && v.allocation.settlement.executor == employer
            && leg.instrumentId == market.asset && leg.amount == principal + fee)
        _ <- exercise allocationCid Allocation_ExecuteTransfer with extraArgs
        _ <- exercise marketCid Credit_Receive with principal, received = principal + fee
        _ <- exercise lineCid AdvanceLineCn_Restore with amount = principal
        create AdvanceRepaidCn with operator, employee, employer, principal, fee, period

template AdvanceRepaidCn
  with
    operator  : Party
    employee  : Party
    employer  : Party
    principal : Decimal
    fee       : Decimal
    period    : Text
  where
    signatory operator, employee, employer
