-- | Private collateralized credit on the Canton Network Token Standard.
--
-- Lenders supply USDx; borrowers lock Canton Coin and borrow USDx. Every
-- movement of funds is a CIP-56 allocation settled in a single atomic DvP:
--   * supply:   USDx lender -> operator
--   * borrow:   CC borrower -> operator   and   USDx operator -> borrower
--   * repay:    USDx borrower -> operator and   CC operator -> borrower
--   * withdraw: USDx operator -> lender
-- Collateral is priced from the Orvane exchange pool. A loan past the
-- liquidation threshold is closed by selling its collateral into that pool,
-- entirely on-ledger; any surplus is owed back to the borrower.
--
-- Members see the market's totals. Loans and positions are visible to their
-- owner and the operator only, and market choices never name a party.
module Orvane.Credit where

import DA.Action (void, when)
import DA.Time (convertRelTimeToMicroseconds, subTime)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

import Orvane.Exchange (ExchangePool(..), ExchangePool_Swap(..))
import Orvane.Math (bpsDenominator, getAmountOut)

-- ---------------------------------------------------------------- math

owedAt : Int -> Decimal -> Decimal -> Time -> Time -> Decimal
owedAt yearSeconds principal aprBps since now =
  let micros = convertRelTimeToMicroseconds (subTime now since)
      years = intToDecimal micros / (1000000.0 * intToDecimal yearSeconds)
  in principal + principal * aprBps / bpsDenominator * max 0.0 years

borrowApr : Decimal -> Decimal -> Decimal -> Decimal -> Decimal
borrowApr baseBps slopeBps cash principalOut =
  let total = cash + principalOut
  in baseBps + slopeBps * (if total == 0.0 then 0.0 else principalOut / total)

-- | Asset per unit of collateral, from the exchange pool.
priceOf : ExchangePool -> InstrumentId -> InstrumentId -> Decimal
priceOf pool asset coll
  | pool.instrA == asset && pool.instrB == coll = pool.reserveA / pool.reserveB
  | pool.instrB == asset && pool.instrA == coll = pool.reserveB / pool.reserveA
  | otherwise = error "pool does not price this market"

-- ---------------------------------------------------------------- allocations

allocateVia : ContractId AllocationFactory -> Party -> AllocationSpecification -> Time -> [ContractId Holding] -> ExtraArgs -> Update (ContractId Allocation)
allocateVia factoryCid expectedAdmin allocation requestedAt inputHoldingCids extraArgs = do
  res <- exercise factoryCid AllocationFactory_Allocate with expectedAdmin, allocation, requestedAt, inputHoldingCids, extraArgs
  case res.output of
    AllocationInstructionResult_Completed c -> pure c
    _ -> abort "the registry did not complete the allocation immediately"

-- | Check an allocation is exactly the leg we expect.
legIs : AllocationView -> Party -> Party -> Party -> InstrumentId -> Decimal -> Text -> Bool
legIs v sender receiver executor instrument amount ref =
  let leg = v.allocation.transferLeg
      s = v.allocation.settlement
  in leg.sender == sender && leg.receiver == receiver && s.executor == executor
       && leg.instrumentId == instrument && leg.amount == amount && s.settlementRef.id == ref

-- ---------------------------------------------------------------- market

template CreditMarket
  with
    operator     : Party
    marketId     : Text
    asset        : InstrumentId   -- lent (USDx)
    collateral   : InstrumentId   -- locked (Canton Coin)
    poolId       : Text           -- Orvane exchange pool used for pricing and liquidation
    cash         : Decimal
    principalOut : Decimal
    totalShares  : Decimal
    baseAprBps   : Decimal
    slopeAprBps  : Decimal
    maxLtvBps    : Decimal
    liqLtvBps    : Decimal
    yearSeconds  : Int
    badDebt      : Decimal
    members      : [Party]
  where
    signatory operator
    observer members
    ensure cash >= 0.0 && principalOut >= 0.0 && totalShares >= 0.0
      && maxLtvBps > 0.0 && maxLtvBps < liqLtvBps && liqLtvBps < bpsDenominator && yearSeconds > 0

    choice Credit_Deposit : (ContractId CreditMarket, Decimal)
      with
        amount : Decimal
      controller operator
      do
        let value = cash + principalOut
            minted = if totalShares == 0.0 || value == 0.0 then amount else amount * totalShares / value
        m <- create this with cash = cash + amount, totalShares = totalShares + minted
        pure (m, minted)

    -- | Burn shares; `paid` is what the operator allocated (never above their value).
    choice Credit_Withdraw : ContractId CreditMarket
      with
        shares : Decimal
        paid   : Decimal
      controller operator
      do
        assertMsg "invalid shares" (shares > 0.0 && shares <= totalShares)
        let value = shares * (cash + principalOut) / totalShares
        assertMsg "payout above the position's value" (paid <= value && paid > 0.0)
        assertMsg "not enough idle cash in the market" (paid <= cash)
        create this with cash = cash - paid, totalShares = totalShares - shares

    choice Credit_Lend : ContractId CreditMarket
      with
        amount : Decimal
      controller operator
      do
        assertMsg "not enough cash to lend" (amount > 0.0 && amount <= cash)
        create this with cash = cash - amount, principalOut = principalOut + amount

    -- | A repayment of `principal` arrives as `received`. Above principal is
    -- interest for suppliers; below is recorded as bad debt.
    choice Credit_Receive : ContractId CreditMarket
      with
        principal : Decimal
        received  : Decimal
      controller operator
      do create this with
           cash = cash + received
           principalOut = max 0.0 (principalOut - principal)
           badDebt = badDebt + max 0.0 (principal - received)

    choice Credit_SetMembers : ContractId CreditMarket
      with
        newMembers : [Party]
      controller operator
      do create this with members = newMembers

-- ---------------------------------------------------------------- supply

template CreditPosition
  with
    operator : Party
    owner    : Party
    marketId : Text
    shares   : Decimal
  where
    signatory operator
    observer owner
    ensure shares > 0.0

template CreditSupplyOrder
  with
    lender           : Party
    operator         : Party
    marketId         : Text
    factoryCid       : ContractId AllocationFactory
    expectedAdmin    : Party
    allocation       : AllocationSpecification
    requestedAt      : Time
    inputHoldingCids : [ContractId Holding]
    extraArgs        : ExtraArgs
  where
    signatory lender

    choice CreditSupplyOrder_Place : ContractId CreditSupplyRequest
      controller lender
      do
        let leg = allocation.transferLeg
        assertMsg "supply must go from the lender to the operator"
          (leg.sender == lender && leg.receiver == operator && allocation.settlement.executor == operator)
        alloc <- allocateVia factoryCid expectedAdmin allocation requestedAt inputHoldingCids extraArgs
        create CreditSupplyRequest with
          lender, operator, marketId, allocationCid = alloc, amount = leg.amount
          ref = allocation.settlement.settlementRef.id

template CreditSupplyRequest
  with
    lender        : Party
    operator      : Party
    marketId      : Text
    allocationCid : ContractId Allocation
    amount        : Decimal
    ref           : Text
  where
    signatory lender
    observer operator

    choice CreditSupplyRequest_Settle : ContractId CreditPosition
      with
        marketCid : ContractId CreditMarket
        extraArgs : ExtraArgs
      controller operator
      do
        market <- fetch marketCid
        assertMsg "wrong market" (market.marketId == marketId && market.operator == operator)
        v <- view <$> fetch allocationCid
        assertMsg "allocation does not match" (legIs v lender operator operator market.asset amount ref)
        _ <- exercise allocationCid Allocation_ExecuteTransfer with extraArgs
        (_, minted) <- exercise marketCid Credit_Deposit with amount
        create CreditPosition with operator, owner = lender, marketId, shares = minted

    choice CreditSupplyRequest_Reject : ()
      with
        cancelArgs : ExtraArgs
      controller operator
      do
        _ <- exercise allocationCid Allocation_Cancel with extraArgs = cancelArgs
        pure ()

template CreditWithdrawRequest
  with
    lender      : Party
    operator    : Party
    positionCid : ContractId CreditPosition
  where
    signatory lender
    observer operator

    choice CreditWithdrawRequest_Settle : ()
      with
        marketCid           : ContractId CreditMarket
        payoutAllocationCid : ContractId Allocation
        ref                 : Text
        extraArgs           : ExtraArgs
      controller operator
      do
        pos <- fetch positionCid
        market <- fetch marketCid
        assertMsg "position does not match" (pos.owner == lender && pos.marketId == market.marketId)
        v <- view <$> fetch payoutAllocationCid
        let paid = v.allocation.transferLeg.amount
        assertMsg "payout allocation does not match" (legIs v operator lender operator market.asset paid ref)
        archive positionCid
        _ <- exercise marketCid Credit_Withdraw with shares = pos.shares, paid
        _ <- exercise payoutAllocationCid Allocation_ExecuteTransfer with extraArgs
        pure ()

    choice CreditWithdrawRequest_Cancel : ()
      controller lender
      do pure ()

-- ---------------------------------------------------------------- borrow

template CreditBorrowOrder
  with
    borrower         : Party
    operator         : Party
    marketId         : Text
    factoryCid       : ContractId AllocationFactory
    expectedAdmin    : Party
    allocation       : AllocationSpecification   -- the collateral leg
    requestedAt      : Time
    inputHoldingCids : [ContractId Holding]
    extraArgs        : ExtraArgs
    borrowAmount     : Decimal
  where
    signatory borrower

    choice CreditBorrowOrder_Place : ContractId CreditBorrowRequest
      controller borrower
      do
        let leg = allocation.transferLeg
        assertMsg "collateral must go from the borrower to the operator"
          (leg.sender == borrower && leg.receiver == operator && allocation.settlement.executor == operator)
        assertMsg "borrow amount must be positive" (borrowAmount > 0.0)
        alloc <- allocateVia factoryCid expectedAdmin allocation requestedAt inputHoldingCids extraArgs
        create CreditBorrowRequest with
          borrower, operator, marketId, collateralAllocationCid = alloc
          collateralAmount = leg.amount, borrowAmount
          ref = allocation.settlement.settlementRef.id

template CreditBorrowRequest
  with
    borrower                : Party
    operator                : Party
    marketId                : Text
    collateralAllocationCid : ContractId Allocation
    collateralAmount        : Decimal
    borrowAmount            : Decimal
    ref                     : Text
  where
    signatory borrower
    observer operator

    -- | Collateral in, loan out, in one transaction.
    choice CreditBorrowRequest_Settle : ContractId CreditLoan
      with
        marketCid         : ContractId CreditMarket
        poolCid           : ContractId ExchangePool
        loanAllocationCid : ContractId Allocation
        collateralArgs    : ExtraArgs
        loanArgs          : ExtraArgs
      controller operator
      do
        market <- fetch marketCid
        pool <- fetch poolCid
        assertMsg "wrong market or pool" (market.marketId == marketId && pool.poolId == market.poolId)
        let price = priceOf pool market.asset market.collateral
            limit = collateralAmount * price * market.maxLtvBps / bpsDenominator
        assertMsg "borrow exceeds the collateral's limit" (borrowAmount <= limit)
        cv <- view <$> fetch collateralAllocationCid
        assertMsg "collateral allocation does not match" (legIs cv borrower operator operator market.collateral collateralAmount ref)
        lv <- view <$> fetch loanAllocationCid
        assertMsg "loan allocation does not match" (legIs lv operator borrower operator market.asset borrowAmount ref)
        let apr = borrowApr market.baseAprBps market.slopeAprBps (market.cash - borrowAmount) (market.principalOut + borrowAmount)
        _ <- exercise marketCid Credit_Lend with amount = borrowAmount
        _ <- exercise collateralAllocationCid Allocation_ExecuteTransfer with extraArgs = collateralArgs
        _ <- exercise loanAllocationCid Allocation_ExecuteTransfer with extraArgs = loanArgs
        now <- getTime
        create CreditLoan with
          operator, borrower, marketId, principal = borrowAmount, aprBps = apr, openedAt = now, collateralAmount

    choice CreditBorrowRequest_Reject : ()
      with
        reason     : Text
        cancelArgs : ExtraArgs
      controller operator
      do
        _ <- exercise collateralAllocationCid Allocation_Cancel with extraArgs = cancelArgs
        pure ()

-- | An open loan. Its collateral is held by the operator.
template CreditLoan
  with
    operator         : Party
    borrower         : Party
    marketId         : Text
    principal        : Decimal
    aprBps           : Decimal
    openedAt         : Time
    collateralAmount : Decimal
  where
    signatory operator, borrower

    -- | Sell the collateral into the exchange pool and repay the market.
    -- Allowed only past the liquidation threshold.
    choice CreditLoan_Liquidate : ContractId CreditLoanClosed
      with
        marketCid : ContractId CreditMarket
        poolCid   : ContractId ExchangePool
      controller operator
      do
        market <- fetch marketCid
        pool <- fetch poolCid
        assertMsg "wrong market or pool" (market.marketId == marketId && pool.poolId == market.poolId)
        now <- getTime
        let owed = owedAt market.yearSeconds principal aprBps openedAt now
            price = priceOf pool market.asset market.collateral
        assertMsg "loan is healthy" (owed * bpsDenominator > collateralAmount * price * market.liqLtvBps)
        let (resIn, resOut) = if pool.instrA == market.collateral then (pool.reserveA, pool.reserveB) else (pool.reserveB, pool.reserveA)
            proceeds = getAmountOut pool.feeBps collateralAmount resIn resOut
            repay = min proceeds owed
        _ <- exercise poolCid ExchangePool_Swap with
          inInstrument = market.collateral, amountIn = collateralAmount, amountOut = proceeds, minOut = 0.0
        _ <- exercise marketCid Credit_Receive with principal, received = repay
        let surplus = proceeds - repay
        when (surplus > 0.0) $ void $
          create CreditSurplus with operator, borrower, marketId, amount = surplus
        create CreditLoanClosed with
          operator, borrower, marketId, principal, paid = repay, collateralReturned = 0.0, liquidated = True, closedAt = now

-- | Borrower's repayment: USDx in, collateral back, atomically.
template CreditRepayOrder
  with
    borrower         : Party
    operator         : Party
    loanCid          : ContractId CreditLoan
    factoryCid       : ContractId AllocationFactory
    expectedAdmin    : Party
    allocation       : AllocationSpecification
    requestedAt      : Time
    inputHoldingCids : [ContractId Holding]
    extraArgs        : ExtraArgs
  where
    signatory borrower

    choice CreditRepayOrder_Place : ContractId CreditRepayRequest
      controller borrower
      do
        let leg = allocation.transferLeg
        assertMsg "repayment must go from the borrower to the operator"
          (leg.sender == borrower && leg.receiver == operator && allocation.settlement.executor == operator)
        alloc <- allocateVia factoryCid expectedAdmin allocation requestedAt inputHoldingCids extraArgs
        create CreditRepayRequest with
          borrower, operator, loanCid, repayAllocationCid = alloc, amount = leg.amount
          ref = allocation.settlement.settlementRef.id

template CreditRepayRequest
  with
    borrower            : Party
    operator            : Party
    loanCid             : ContractId CreditLoan
    repayAllocationCid  : ContractId Allocation
    amount              : Decimal
    ref                 : Text
  where
    signatory borrower
    observer operator

    -- | `amount` must cover what is owed now; any dust above it accrues to suppliers.
    choice CreditRepayRequest_Settle : ContractId CreditLoanClosed
      with
        marketCid               : ContractId CreditMarket
        collateralAllocationCid : ContractId Allocation
        repayArgs               : ExtraArgs
        collateralArgs          : ExtraArgs
      controller operator
      do
        loan <- fetch loanCid
        market <- fetch marketCid
        assertMsg "loan does not match" (loan.borrower == borrower && loan.operator == operator && loan.marketId == market.marketId)
        now <- getTime
        let owed = owedAt market.yearSeconds loan.principal loan.aprBps loan.openedAt now
        assertMsg "repayment does not cover what is owed" (amount >= owed)
        rv <- view <$> fetch repayAllocationCid
        assertMsg "repayment allocation does not match" (legIs rv borrower operator operator market.asset amount ref)
        cv <- view <$> fetch collateralAllocationCid
        assertMsg "collateral return does not match" (legIs cv operator borrower operator market.collateral loan.collateralAmount ref)
        archive loanCid
        _ <- exercise marketCid Credit_Receive with principal = loan.principal, received = amount
        _ <- exercise repayAllocationCid Allocation_ExecuteTransfer with extraArgs = repayArgs
        _ <- exercise collateralAllocationCid Allocation_ExecuteTransfer with extraArgs = collateralArgs
        create CreditLoanClosed with
          operator, borrower, marketId = loan.marketId, principal = loan.principal, paid = amount
          collateralReturned = loan.collateralAmount, liquidated = False, closedAt = now

    choice CreditRepayRequest_Reject : ()
      with
        reason     : Text
        cancelArgs : ExtraArgs
      controller operator
      do
        _ <- exercise repayAllocationCid Allocation_Cancel with extraArgs = cancelArgs
        pure ()

template CreditLoanClosed
  with
    operator           : Party
    borrower           : Party
    marketId           : Text
    principal          : Decimal
    paid               : Decimal
    collateralReturned : Decimal
    liquidated         : Bool
    closedAt           : Time
  where
    signatory operator
    observer borrower

-- | Liquidation proceeds above the debt, owed back to the borrower. The
-- operator pays it with a regular token transfer and then archives this.
template CreditSurplus
  with
    operator : Party
    borrower : Party
    marketId : Text
    amount   : Decimal
  where
    signatory operator
    observer borrower

    choice CreditSurplus_Paid : ()
      controller operator
      do pure ()
