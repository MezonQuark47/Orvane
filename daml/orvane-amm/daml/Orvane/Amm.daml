-- | Privacy-preserving constant-product AMM.
--
-- Design (why it fits Canton):
--   * The Pool is visible to its operator and onboarded `members` only, so
--     members see reserves (the price) but nothing else.
--   * Traders and LPs never touch the Pool directly. They create a request
--     signed by themselves and observed by the operator only. The operator
--     settles it atomically: input in, pool update, output out, receipt.
--   * Pool choices never carry the trader's identity, so other members see
--     "the pool swapped X for Y" and never *who* traded.
module Orvane.Amm where

import DA.Action (foldlA)
import DA.Optional (fromSomeNote)
import Orvane.Math
import Orvane.Token

-- | A trading pair with its reserves held as operator-owned Tokens.
template Pool
  with
    operator    : Party
    poolId      : Text
    issuerA     : Party
    symbolA     : Text
    issuerB     : Party
    symbolB     : Text
    reserveA    : Decimal
    reserveB    : Decimal
    holdingA    : Optional (ContractId Token)
    holdingB    : Optional (ContractId Token)
    totalShares : Decimal
    feeBps      : Decimal
    members     : [Party]
  where
    signatory operator
    observer members
    ensure (issuerA, symbolA) /= (issuerB, symbolB)
      && reserveA >= 0.0 && reserveB >= 0.0 && totalShares >= 0.0
      && feeBps >= 0.0 && feeBps < 1000.0

    -- | Swap an operator-owned input holding. Returns the new pool, the
    -- operator-owned output holding and the output amount.
    choice Pool_Swap : (ContractId Pool, ContractId Token, Decimal)
      with
        inCid  : ContractId Token
        minOut : Decimal
      controller operator
      do
        input <- fetch inCid
        assertMsg "input must be owned by the operator" (input.owner == operator)
        assertMsg "pool has no liquidity" (reserveA > 0.0 && reserveB > 0.0)
        let isA = (input.issuer, input.symbol) == (issuerA, symbolA)
            isB = (input.issuer, input.symbol) == (issuerB, symbolB)
        assertMsg "input token does not belong to this pool" (isA || isB)
        let (resIn, resOut) = if isA then (reserveA, reserveB) else (reserveB, reserveA)
            out = getAmountOut feeBps input.amount resIn resOut
        assertMsg "slippage: output below minimum" (out >= minOut)
        assertMsg "output must be positive and below reserve" (out > 0.0 && out < resOut)
        if isA then do
          newHoldingA <- mergeInto holdingA inCid
          (outCid, restB) <- takeExact (fromSomeNote "no B holding" holdingB) reserveB out
          pool' <- create this with
            reserveA = reserveA + input.amount, holdingA = Some newHoldingA
            reserveB = reserveB - out,          holdingB = restB
          pure (pool', outCid, out)
        else do
          newHoldingB <- mergeInto holdingB inCid
          (outCid, restA) <- takeExact (fromSomeNote "no A holding" holdingA) reserveA out
          pool' <- create this with
            reserveB = reserveB + input.amount, holdingB = Some newHoldingB
            reserveA = reserveA - out,          holdingA = restA
          pure (pool', outCid, out)

    -- | Add operator-owned holdings of exactly the amounts to deposit.
    choice Pool_AddLiquidity : (ContractId Pool, Decimal)
      with
        cidA : ContractId Token
        cidB : ContractId Token
      controller operator
      do
        a <- fetch cidA
        b <- fetch cidB
        assertMsg "deposits must be owned by the operator" (a.owner == operator && b.owner == operator)
        assertMsg "deposit A has wrong asset" ((a.issuer, a.symbol) == (issuerA, symbolA))
        assertMsg "deposit B has wrong asset" ((b.issuer, b.symbol) == (issuerB, symbolB))
        let minted = sharesForDeposit totalShares reserveA reserveB a.amount b.amount
        assertMsg "deposit too small" (minted > 0.0)
        newA <- mergeInto holdingA cidA
        newB <- mergeInto holdingB cidB
        pool' <- create this with
          reserveA = reserveA + a.amount, holdingA = Some newA
          reserveB = reserveB + b.amount, holdingB = Some newB
          totalShares = totalShares + minted
        pure (pool', minted)

    -- | Burn `shares` and release the proportional reserves to the operator.
    choice Pool_RemoveLiquidity : (ContractId Pool, ContractId Token, ContractId Token, Decimal, Decimal)
      with
        shares : Decimal
      controller operator
      do
        assertMsg "invalid share amount" (shares > 0.0 && shares <= totalShares)
        let outA = if shares == totalShares then reserveA else reserveA * shares / totalShares
            outB = if shares == totalShares then reserveB else reserveB * shares / totalShares
        (cidA, restA) <- takeExact (fromSomeNote "no A holding" holdingA) reserveA outA
        (cidB, restB) <- takeExact (fromSomeNote "no B holding" holdingB) reserveB outB
        pool' <- create this with
          reserveA = reserveA - outA, holdingA = restA
          reserveB = reserveB - outB, holdingB = restB
          totalShares = totalShares - shares
        pure (pool', cidA, cidB, outA, outB)

    -- | Onboard or offboard members (who may see prices and trade).
    choice Pool_SetMembers : ContractId Pool
      with
        newMembers : [Party]
      controller operator
      do create this with members = newMembers

-- | Liquidity-provider position. Visible to the operator and the LP only.
template LpShare
  with
    operator : Party
    owner    : Party
    poolId   : Text
    shares   : Decimal
  where
    signatory operator
    observer owner
    ensure shares > 0.0

-- | Private trade confirmation for the trader.
template SwapReceipt
  with
    operator  : Party
    trader    : Party
    poolId    : Text
    symbolIn  : Text
    amountIn  : Decimal
    symbolOut : Text
    amountOut : Decimal
  where
    signatory operator
    observer trader

-- | A trader's signed intent to swap. Only the operator sees it.
-- The input token must already be disclosed to the operator.
template SwapRequest
  with
    trader    : Party
    operator  : Party
    poolId    : Text
    inputCid  : ContractId Token
    minOutput : Decimal
  where
    signatory trader
    observer operator
    ensure minOutput >= 0.0

    choice SwapRequest_Execute : (ContractId Pool, ContractId Token, ContractId SwapReceipt)
      with
        poolCid : ContractId Pool
      controller operator
      do
        pool <- fetch poolCid
        assertMsg "wrong pool" (pool.poolId == poolId && pool.operator == operator)
        input <- fetch inputCid
        assertMsg "input not owned by trader" (input.owner == trader)
        inOp <- exercise inputCid Transfer with newOwner = operator
        (pool', outOp, outAmt) <- exercise poolCid Pool_Swap with inCid = inOp, minOut = minOutput
        out <- exercise outOp Transfer with newOwner = trader
        let symbolOut = if (input.issuer, input.symbol) == (pool.issuerA, pool.symbolA)
                          then pool.symbolB else pool.symbolA
        receipt <- create SwapReceipt with
          operator, trader, poolId
          symbolIn = input.symbol, amountIn = input.amount
          symbolOut, amountOut = outAmt
        pure (pool', out, receipt)

    choice SwapRequest_Reject : ()
      with
        reason : Text
      controller operator
      do pure ()

    choice SwapRequest_Cancel : ()
      controller trader
      do pure ()

-- | Merge the given holdings, carve out exactly `amount` and disclose that
-- piece to the operator. Any remainder stays with the owner, undisclosed.
prepareInput : Party -> [ContractId Token] -> Decimal -> Update (ContractId Token)
prepareInput operator holdings amount = case holdings of
  [] -> abort "no holdings given"
  first :: rest -> do
    merged <- foldlA (\acc next -> exercise acc Merge with otherCid = next) first rest
    tok <- fetch merged
    assertMsg "insufficient balance" (amount > 0.0 && amount <= tok.amount)
    (exact, _) <- takeExact merged tok.amount amount
    exercise exact Disclose with party = operator

-- | Wallet-friendly entry point: one createAndExercise, one signature.
-- Prepares the input and files a SwapRequest.
template SwapOrder
  with
    trader    : Party
    operator  : Party
    poolId    : Text
    holdings  : [ContractId Token]
    amount    : Decimal
    minOutput : Decimal
  where
    signatory trader

    choice SwapOrder_Place : ContractId SwapRequest
      controller trader
      do
        inputCid <- prepareInput operator holdings amount
        create SwapRequest with trader, operator, poolId, inputCid, minOutput

-- | Wallet-friendly entry point for deposits.
template LiquidityOrder
  with
    provider  : Party
    operator  : Party
    poolId    : Text
    holdingsA : [ContractId Token]
    amountA   : Decimal
    holdingsB : [ContractId Token]
    amountB   : Decimal
    minShares : Decimal
  where
    signatory provider

    choice LiquidityOrder_Place : ContractId AddLiquidityRequest
      controller provider
      do
        cidA <- prepareInput operator holdingsA amountA
        cidB <- prepareInput operator holdingsB amountB
        create AddLiquidityRequest with provider, operator, poolId, cidA, cidB, minShares

-- | An LP's signed intent to deposit. Excess on one side is refunded so the
-- pool ratio is preserved. Both tokens must be disclosed to the operator.
template AddLiquidityRequest
  with
    provider  : Party
    operator  : Party
    poolId    : Text
    cidA      : ContractId Token
    cidB      : ContractId Token
    minShares : Decimal
  where
    signatory provider
    observer operator

    choice AddLiquidityRequest_Execute : (ContractId Pool, ContractId LpShare)
      with
        poolCid : ContractId Pool
      controller operator
      do
        pool <- fetch poolCid
        assertMsg "wrong pool" (pool.poolId == poolId && pool.operator == operator)
        a <- fetch cidA
        b <- fetch cidB
        assertMsg "deposits not owned by provider" (a.owner == provider && b.owner == provider)
        let (useA, useB) = optimalDeposit pool.reserveA pool.reserveB a.amount b.amount
        (depA, _) <- takeExact cidA a.amount useA
        (depB, _) <- takeExact cidB b.amount useB
        opA <- exercise depA Transfer with newOwner = operator
        opB <- exercise depB Transfer with newOwner = operator
        (pool', minted) <- exercise poolCid Pool_AddLiquidity with cidA = opA, cidB = opB
        assertMsg "slippage: shares below minimum" (minted >= minShares)
        lp <- create LpShare with operator, owner = provider, poolId, shares = minted
        pure (pool', lp)

    choice AddLiquidityRequest_Cancel : ()
      controller provider
      do pure ()

-- | An LP's signed intent to withdraw.
template RemoveLiquidityRequest
  with
    provider : Party
    operator : Party
    lpCid    : ContractId LpShare
    minA     : Decimal
    minB     : Decimal
  where
    signatory provider
    observer operator

    choice RemoveLiquidityRequest_Execute : (ContractId Pool, ContractId Token, ContractId Token)
      with
        poolCid : ContractId Pool
      controller operator
      do
        lp <- fetch lpCid
        pool <- fetch poolCid
        assertMsg "position does not match" (lp.owner == provider && lp.operator == operator && lp.poolId == pool.poolId)
        archive lpCid
        (pool', opA, opB, outA, outB) <- exercise poolCid Pool_RemoveLiquidity with shares = lp.shares
        assertMsg "slippage: withdrawal below minimum" (outA >= minA && outB >= minB)
        tokA <- exercise opA Transfer with newOwner = provider
        tokB <- exercise opB Transfer with newOwner = provider
        pure (pool', tokA, tokB)

    choice RemoveLiquidityRequest_Cancel : ()
      controller provider
      do pure ()
