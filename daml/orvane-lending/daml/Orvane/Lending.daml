-- | Private collateralized lending.
--
-- Lenders supply USDx to a market and receive shares whose value grows as
-- borrowers pay interest. Borrowers lock CCx as collateral and borrow USDx.
-- Collateral is priced from the Orvane AMM pool. If a loan becomes unsafe,
-- the operator liquidates it by selling the collateral through that pool,
-- in the same transaction that repays the market.
--
-- Who sees what:
--   * Market members see the market's totals (cash, outstanding principal,
--     rate). Market choices never carry a lender's or borrower's identity.
--   * A loan is visible to its borrower and the operator only.
--   * A supply position is visible to its owner and the operator only.
module Orvane.Lending where

import DA.Action (foldlA)
import DA.Foldable (forA_)
import DA.Optional (optionalToList)
import DA.Time (convertRelTimeToMicroseconds, subTime)
import Orvane.Amm (Pool(..), Pool_Swap(..), prepareInput)
import Orvane.Math (bpsDenominator)
import Orvane.Pay.Util (mergeHoldings)
import Orvane.Token

-- ---------------------------------------------------------------- math

-- | Principal plus simple interest accrued since `since`.
-- `yearSeconds` lets a demo market run on a compressed clock.
owedAt : Int -> Decimal -> Decimal -> Time -> Time -> Decimal
owedAt yearSeconds principal aprBps since now =
  let micros = convertRelTimeToMicroseconds (subTime now since)
      years = intToDecimal micros / (1000000.0 * intToDecimal yearSeconds)
  in principal + principal * aprBps / bpsDenominator * max 0.0 years

-- | Utilization-based borrow rate: base + slope * utilization.
borrowApr : Decimal -> Decimal -> Decimal -> Decimal -> Decimal
borrowApr baseBps slopeBps cash principalOut =
  let total = cash + principalOut
      util = if total == 0.0 then 0.0 else principalOut / total
  in baseBps + slopeBps * util

-- | USDx per unit of collateral, from the AMM pool's reserves.
collateralPrice : Pool -> Party -> Text -> Party -> Text -> Decimal
collateralPrice pool assetIssuer assetSymbol collIssuer collSymbol
  | (assetIssuer, assetSymbol) == (pool.issuerA, pool.symbolA)
      && (collIssuer, collSymbol) == (pool.issuerB, pool.symbolB) = pool.reserveA / pool.reserveB
  | (assetIssuer, assetSymbol) == (pool.issuerB, pool.symbolB)
      && (collIssuer, collSymbol) == (pool.issuerA, pool.symbolA) = pool.reserveB / pool.reserveA
  | otherwise = error "pool does not price this market's collateral"

-- ---------------------------------------------------------------- market

template LendingMarket
  with
    operator     : Party
    marketId     : Text
    assetIssuer  : Party
    assetSymbol  : Text        -- what is lent (USDx)
    collIssuer   : Party
    collSymbol   : Text        -- what secures loans (CCx)
    poolId       : Text        -- AMM pool used for pricing and liquidations
    cash         : Decimal
    cashHoldings : [ContractId Token]  -- merged lazily by the operator
    principalOut : Decimal
    totalShares  : Decimal
    baseAprBps   : Decimal
    slopeAprBps  : Decimal
    maxLtvBps    : Decimal     -- max borrow as share of collateral value
    liqLtvBps    : Decimal     -- liquidation threshold
    yearSeconds  : Int
    badDebt      : Decimal
    members      : [Party]
  where
    signatory operator
    observer members
    ensure cash >= 0.0 && principalOut >= 0.0 && totalShares >= 0.0
      && maxLtvBps > 0.0 && maxLtvBps < liqLtvBps && liqLtvBps < bpsDenominator
      && yearSeconds > 0

    -- | Add operator-owned asset to the market's cash, minting supply shares.
    choice Market_Deposit : (ContractId LendingMarket, Decimal)
      with
        incoming : ContractId Token
      controller operator
      do
        tok <- fetch incoming
        assertMsg "wrong asset" ((tok.issuer, tok.symbol) == (assetIssuer, assetSymbol) && tok.owner == operator)
        let value = cash + principalOut
            minted = if totalShares == 0.0 || value == 0.0 then tok.amount else tok.amount * totalShares / value
        -- kept separate; merged when cash next leaves the market
        m <- create this with cash = cash + tok.amount, cashHoldings = incoming :: cashHoldings, totalShares = totalShares + minted
        pure (m, minted)

    -- | Burn supply shares for their share of the market, paid from cash.
    choice Market_Withdraw : (ContractId LendingMarket, ContractId Token, Decimal)
      with
        shares : Decimal
      controller operator
      do
        assertMsg "invalid shares" (shares > 0.0 && shares <= totalShares)
        let amount = shares * (cash + principalOut) / totalShares
        assertMsg "not enough idle cash in the market right now" (amount <= cash)
        (out, rest) <- takeCash cashHoldings cash amount
        m <- create this with cash = cash - amount, cashHoldings = optionalToList rest, totalShares = totalShares - shares
        pure (m, out, amount)

    -- | Take cash out as a new loan's principal.
    choice Market_Lend : (ContractId LendingMarket, ContractId Token)
      with
        amount : Decimal
      controller operator
      do
        assertMsg "not enough cash to lend" (amount > 0.0 && amount <= cash)
        (out, rest) <- takeCash cashHoldings cash amount
        m <- create this with cash = cash - amount, cashHoldings = optionalToList rest, principalOut = principalOut + amount
        pure (m, out)

    -- | Receive a repayment. Anything above `principal` is interest or fees
    -- and accrues to suppliers; anything below is recorded as bad debt.
    choice Market_Receive : ContractId LendingMarket
      with
        incoming  : ContractId Token
        principal : Decimal
      controller operator
      do
        tok <- fetch incoming
        assertMsg "wrong asset" ((tok.issuer, tok.symbol) == (assetIssuer, assetSymbol) && tok.owner == operator)
        -- appended, not merged: the submitter (a borrower) cannot see the market's other holdings
        create this with
          cash = cash + tok.amount
          cashHoldings = incoming :: cashHoldings
          principalOut = max 0.0 (principalOut - principal)
          badDebt = badDebt + max 0.0 (principal - tok.amount)

    choice Market_SetMembers : ContractId LendingMarket
      with
        newMembers : [Party]
      controller operator
      do create this with members = newMembers

-- ---------------------------------------------------------------- supply

template SupplyPosition
  with
    operator : Party
    owner    : Party
    marketId : Text
    shares   : Decimal
  where
    signatory operator
    observer owner
    ensure shares > 0.0

-- | One-signature deposit: prepare the funds and file a request.
template SupplyOrder
  with
    lender   : Party
    operator : Party
    marketId : Text
    holdings : [ContractId Token]
    amount   : Decimal
  where
    signatory lender

    choice SupplyOrder_Place : ContractId SupplyRequest
      controller lender
      do
        inputCid <- prepareInput operator holdings amount
        create SupplyRequest with lender, operator, marketId, inputCid

template SupplyRequest
  with
    lender   : Party
    operator : Party
    marketId : Text
    inputCid : ContractId Token
  where
    signatory lender
    observer operator

    choice SupplyRequest_Execute : ContractId SupplyPosition
      with
        marketCid : ContractId LendingMarket
      controller operator
      do
        market <- fetch marketCid
        assertMsg "wrong market" (market.marketId == marketId && market.operator == operator)
        inOp <- exercise inputCid Transfer with newOwner = operator
        (_, minted) <- exercise marketCid Market_Deposit with incoming = inOp
        create SupplyPosition with operator, owner = lender, marketId, shares = minted

    choice SupplyRequest_Cancel : ()
      controller lender
      do pure ()

template WithdrawSupplyRequest
  with
    lender      : Party
    operator    : Party
    positionCid : ContractId SupplyPosition
  where
    signatory lender
    observer operator

    choice WithdrawSupplyRequest_Execute : ContractId Token
      with
        marketCid : ContractId LendingMarket
      controller operator
      do
        pos <- fetch positionCid
        market <- fetch marketCid
        assertMsg "position does not match" (pos.owner == lender && pos.marketId == market.marketId)
        archive positionCid
        (_, out, _) <- exercise marketCid Market_Withdraw with shares = pos.shares
        exercise out Transfer with newOwner = lender

    choice WithdrawSupplyRequest_Cancel : ()
      controller lender
      do pure ()

-- ---------------------------------------------------------------- loans

-- | One-signature borrow: lock collateral (disclosed to the operator) and
-- file a request for `borrowAmount`.
template BorrowOrder
  with
    borrower         : Party
    operator         : Party
    marketId         : Text
    holdings         : [ContractId Token]
    collateralAmount : Decimal
    borrowAmount     : Decimal
  where
    signatory borrower

    choice BorrowOrder_Place : ContractId BorrowRequest
      controller borrower
      do
        collateralCid <- prepareInput operator holdings collateralAmount
        create BorrowRequest with borrower, operator, marketId, collateralCid, borrowAmount

template BorrowRequest
  with
    borrower      : Party
    operator      : Party
    marketId      : Text
    collateralCid : ContractId Token
    borrowAmount  : Decimal
  where
    signatory borrower
    observer operator
    ensure borrowAmount > 0.0

    choice BorrowRequest_Execute : ContractId Loan
      with
        marketCid : ContractId LendingMarket
        poolCid   : ContractId Pool
      controller operator
      do
        market <- fetch marketCid
        pool <- fetch poolCid
        assertMsg "wrong market or pool" (market.marketId == marketId && pool.poolId == market.poolId)
        coll <- fetch collateralCid
        assertMsg "collateral not owned by borrower" (coll.owner == borrower)
        assertMsg "wrong collateral asset" ((coll.issuer, coll.symbol) == (market.collIssuer, market.collSymbol))
        let price = collateralPrice pool market.assetIssuer market.assetSymbol market.collIssuer market.collSymbol
            limit = coll.amount * price * market.maxLtvBps / bpsDenominator
        assertMsg "borrow exceeds the collateral's limit" (borrowAmount <= limit)
        escrowed <- exercise collateralCid Transfer with newOwner = operator
        -- the borrower keeps sight of their collateral so they can repay directly
        escrow <- exercise escrowed Disclose with party = borrower
        let apr = borrowApr market.baseAprBps market.slopeAprBps (market.cash - borrowAmount) (market.principalOut + borrowAmount)
        (_, cashOut) <- exercise marketCid Market_Lend with amount = borrowAmount
        _ <- exercise cashOut Transfer with newOwner = borrower
        now <- getTime
        create Loan with
          operator, borrower, marketId
          principal = borrowAmount, aprBps = apr, openedAt = now
          collateralCid = escrow, collateralAmount = coll.amount

    choice BorrowRequest_Reject : ()
      with
        reason : Text
      controller operator
      do pure ()

    choice BorrowRequest_Cancel : ()
      controller borrower
      do pure ()

-- | An open loan. Visible to the borrower and the operator only.
template Loan
  with
    operator         : Party
    borrower         : Party
    marketId         : Text
    principal        : Decimal
    aprBps           : Decimal
    openedAt         : Time
    collateralCid    : ContractId Token  -- operator-owned escrow
    collateralAmount : Decimal
  where
    signatory operator, borrower

    -- | Repay in full and get the collateral back. Settles directly; the
    -- market's members see a repayment arrive, not who made it.
    choice Loan_Repay : ContractId LoanClosed
      with
        holdings  : [ContractId Token]
        marketCid : ContractId LendingMarket
      controller borrower
      do
        market <- fetch marketCid
        assertMsg "wrong market" (market.marketId == marketId && market.operator == operator)
        now <- getTime
        let owed = owedAt market.yearSeconds principal aprBps openedAt now
        (merged, balance) <- mergeHoldings market.assetIssuer market.assetSymbol holdings
        assertMsg "insufficient balance to repay" (balance >= owed)
        (payment, _) <- takeExact merged balance owed
        paid <- exercise payment Transfer with newOwner = operator
        _ <- exercise marketCid Market_Receive with incoming = paid, principal
        _ <- exercise collateralCid Transfer with newOwner = borrower
        create LoanClosed with
          operator, borrower, marketId, principal, interest = owed - principal
          collateralReturned = collateralAmount, liquidated = False, closedAt = now

    -- | Lock more collateral to improve the loan's health.
    choice Loan_AddCollateral : ContractId Loan
      with
        holdings : [ContractId Token]
        amount   : Decimal
      controller borrower
      do
        esc <- fetch collateralCid
        (merged, balance) <- mergeHoldings esc.issuer esc.symbol holdings
        assertMsg "insufficient collateral balance" (amount > 0.0 && amount <= balance)
        (piece, _) <- takeExact merged balance amount
        moved <- exercise piece Transfer with newOwner = operator
        newEscrow <- exercise collateralCid Merge with otherCid = moved
        create this with collateralCid = newEscrow, collateralAmount = collateralAmount + amount

    -- | Sell the collateral through the AMM and repay the market, atomically.
    -- Only allowed once debt exceeds the liquidation threshold.
    choice Loan_Liquidate : ContractId LoanClosed
      with
        marketCid : ContractId LendingMarket
        poolCid   : ContractId Pool
      controller operator
      do
        market <- fetch marketCid
        pool <- fetch poolCid
        assertMsg "wrong market or pool" (market.marketId == marketId && pool.poolId == market.poolId)
        now <- getTime
        let owed = owedAt market.yearSeconds principal aprBps openedAt now
            price = collateralPrice pool market.assetIssuer market.assetSymbol market.collIssuer market.collSymbol
            value = collateralAmount * price
        assertMsg "loan is healthy" (owed * bpsDenominator > value * market.liqLtvBps)
        (_, proceeds, outAmt) <- exercise poolCid Pool_Swap with inCid = collateralCid, minOut = 0.0
        let repay = min outAmt owed
        (repayCid, surplus) <- takeExact proceeds outAmt repay
        _ <- exercise marketCid Market_Receive with incoming = repayCid, principal
        forA_ surplus (\s -> exercise s Transfer with newOwner = borrower)
        create LoanClosed with
          operator, borrower, marketId, principal, interest = repay - principal
          collateralReturned = 0.0, liquidated = True, closedAt = now

-- | Private record of a closed loan for the borrower.
template LoanClosed
  with
    operator           : Party
    borrower           : Party
    marketId           : Text
    principal          : Decimal
    interest           : Decimal
    collateralReturned : Decimal
    liquidated         : Bool
    closedAt           : Time
  where
    signatory operator
    observer borrower

-- | Merge the market's cash holdings and carve out `amount`.
takeCash : [ContractId Token] -> Decimal -> Decimal -> Update (ContractId Token, Optional (ContractId Token))
takeCash holdings total amount = case holdings of
  [] -> abort "market has no cash"
  first :: rest -> do
    merged <- foldlA (\acc next -> exercise acc Merge with otherCid = next) first rest
    takeExact merged total amount

fromSomeNote : Text -> Optional a -> a
fromSomeNote _ (Some x) = x
fromSomeNote msg None = error msg
