-- | What traders and providers sign. Each order is placed from the user's
-- wallet with one choice on the pool's `OrderDesk`, which locks the funds
-- through the registry and files a request for the operator to fill or
-- reject.
module Orvane.Dex.Orders where

import DA.Foldable (forA_)
import DA.Text qualified as T
import DA.TextMap qualified as TextMap

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.AllocationInstructionV2 qualified as AI

import Orvane.Dex.State
import Orvane.Dex.Token

-- | A record that the operator turned a request down, so the user's wallet
-- can say why.
template RequestRejected
  with
    operator : Party
    party : Party
    poolId : Text
    requestId : Text
    reason : Text
  where
    signatory operator
    observer party

-- | Where wallets place orders for one pool.
--
-- Wallets hosted for external parties can only sign transactions with a
-- single root action, so an order is one exercise on this contract, which
-- the operator publishes and hands to wallets as a disclosed contract. The
-- choices act only with the user's authority where it matters: the
-- allocation is created with the user as the only actor, and the request is
-- signed by the user alone.
template OrderDesk
  with
    operator : Party
    poolId : Text
  where
    signatory operator

    -- Sell exactly `amountIn` for at least `minOut`. The input is locked in
    -- an allocation that names the exact leg (trader to operator,
    -- `amountIn`), so it can be settled for nothing else, and it is not
    -- committed: the trader can pull it back at any time before it settles.
    nonconsuming choice OrderDesk_Swap : ContractId SwapRequest
      with
        trader : Party
        requestId : Text
        instrumentIn : H.InstrumentId
        amountIn : Decimal
        instrumentOut : H.InstrumentId
        minOut : Decimal
        deadline : Time
        allocationFactory : ContractId AI.AllocationFactory
        inputHoldingCids : [ContractId H.Holding]
        requestedAt : Time
        extraArgs : ExtraArgs
      controller trader
      do
        let input = leg (requestId <> "/in") trader operator amountIn instrumentIn.id
        inputAllocation <- allocate instrumentIn.admin allocationFactory AI.AllocationFactory_Allocate with
          settlement = poolSettlement operator poolId
          allocation = oneShot instrumentIn.admin trader [senderSide input] (Some deadline)
          requestedAt
          inputHoldingCids
          extraArgs
          actors = [trader]
        create SwapRequest with ..

    -- Lock `amountA` and `amountB` in the provider's own account until
    -- `termEnd`, for the operator to open a position on.
    nonconsuming choice OrderDesk_Deposit : ContractId DepositRequest
      with
        provider : Party
        requestId : Text
        instrumentA : H.InstrumentId
        amountA : Decimal
        instrumentB : H.InstrumentId
        amountB : Decimal
        termEnd : Time
        factoryA : ContractId AI.AllocationFactory
        holdingsA : [ContractId H.Holding]
        extraArgsA : ExtraArgs
        factoryB : ContractId AI.AllocationFactory
        holdingsB : [ContractId H.Holding]
        extraArgsB : ExtraArgs
        requestedAt : Time
      controller provider
      do
        let lock instrument amount factory holdings args =
              allocate instrument.admin factory AI.AllocationFactory_Allocate with
                settlement = poolSettlement operator poolId
                allocation = providerFunding provider instrument amount termEnd
                requestedAt
                inputHoldingCids = holdings
                extraArgs = args
                actors = [provider]
        allocationA <- lock instrumentA amountA factoryA holdingsA extraArgsA
        allocationB <- lock instrumentB amountB factoryB holdingsB extraArgsB
        create DepositRequest with ..

-- Swaps
--------

template SwapRequest
  with
    trader : Party
    operator : Party
    poolId : Text
    requestId : Text
    instrumentIn : H.InstrumentId
    amountIn : Decimal
    instrumentOut : H.InstrumentId
    minOut : Decimal
    deadline : Time
    inputAllocation : ContractId A.Allocation
  where
    signatory trader
    observer operator
    ensure amountIn > 0.0 && minOut > 0.0 && instrumentIn /= instrumentOut && not (T.isEmpty requestId)

    -- Called by the pool while it settles the swap: create the trader's
    -- receipt for exactly `amountOut`, which must meet the trader's minimum.
    -- The check lives here, in the contract the trader signed, so it holds
    -- whatever the operator passes in.
    choice SwapRequest_Fill : ContractId A.Allocation
      with
        amountOut : Decimal
        allocationFactory : ContractId AI.AllocationFactory
        requestedAt : Time
        extraArgs : ExtraArgs
      controller operator
      do
        require "the output meets the trader's minimum" (amountOut >= minOut)
        let output = leg (requestId <> "/out") operator trader amountOut instrumentOut.id
        allocate instrumentOut.admin allocationFactory AI.AllocationFactory_Allocate with
          settlement = poolSettlement operator poolId
          allocation = oneShot instrumentOut.admin trader [receiverSide output] (Some deadline)
          requestedAt
          inputHoldingCids = []
          extraArgs
          actors = [trader]

    -- Turn the swap down and hand the trader's funds straight back. Pass no
    -- cancel arguments if the trader already took the allocation back.
    choice SwapRequest_Reject : ContractId RequestRejected
      with
        reason : Text
        cancelArgs : Optional ExtraArgs
      controller operator
      do
        forA_ cancelArgs $ \extraArgs ->
          exercise inputAllocation A.Allocation_Cancel with actors = [operator]; extraArgs
        create RequestRejected with party = trader; ..

    -- The trader changes their mind before the swap settles.
    choice SwapRequest_Cancel : ()
      with
        withdrawArgs : ExtraArgs
      controller trader
      do
        _ <- exercise inputAllocation A.Allocation_Withdraw with actors = [trader]; extraArgs = withdrawArgs
        pure ()

-- Liquidity
------------

-- | A provider's request to open a position with funds locked in their own
-- account until `termEnd`.
template DepositRequest
  with
    provider : Party
    operator : Party
    poolId : Text
    requestId : Text
    instrumentA : H.InstrumentId
    amountA : Decimal
    allocationA : ContractId A.Allocation
    instrumentB : H.InstrumentId
    amountB : Decimal
    allocationB : ContractId A.Allocation
    termEnd : Time
  where
    signatory provider
    observer operator
    ensure amountA > 0.0 && amountB > 0.0 && instrumentA /= instrumentB && not (T.isEmpty requestId)

    -- Consumed by the pool when it opens the position.
    choice DepositRequest_Take : DepositRequest
      controller operator
      do pure this

    -- The allocations are committed, so only the operator can release them
    -- before the term ends; turning the deposit down does exactly that.
    choice DepositRequest_Reject : ContractId RequestRejected
      with
        reason : Text
        cancelArgsA : ExtraArgs
        cancelArgsB : ExtraArgs
      controller operator
      do
        _ <- exercise allocationA A.Allocation_Cancel with actors = [operator]; extraArgs = cancelArgsA
        _ <- exercise allocationB A.Allocation_Cancel with actors = [operator]; extraArgs = cancelArgsB
        create RequestRejected with party = provider; ..

-- | A provider asks for a position back before its term ends.
template WithdrawRequest
  with
    provider : Party
    operator : Party
    poolId : Text
    positionId : Text
  where
    signatory provider
    observer operator

    choice WithdrawRequest_Take : WithdrawRequest
      controller operator
      do pure this

    choice WithdrawRequest_Cancel : ()
      controller provider
      do pure ()

-- | A provider asks to keep a position open for a new term. The operator
-- releases the old allocations and locks the same amounts again until
-- `termEnd`, in one transaction, so the position never leaves the pool.
template RenewRequest
  with
    provider : Party
    operator : Party
    poolId : Text
    positionId : Text
    termEnd : Time
  where
    signatory provider
    observer operator

    choice RenewRequest_Execute : (ContractId A.Allocation, ContractId A.Allocation)
      with
        positionCid : ContractId LpPosition
        cancelArgsA : ExtraArgs
        factoryA : ContractId AI.AllocationFactory
        allocateArgsA : ExtraArgs
        cancelArgsB : ExtraArgs
        factoryB : ContractId AI.AllocationFactory
        allocateArgsB : ExtraArgs
        requestedAt : Time
      controller operator
      do
        p <- fetch positionCid
        requireEq "position provider" p.provider provider
        requireEq "position id" p.positionId positionId
        requireEq "position pool" p.poolId poolId
        let relock allocationCid instrument amount cancelArgs factory allocateArgs = do
              released <- exercise allocationCid A.Allocation_Cancel with actors = [operator]; extraArgs = cancelArgs
              allocate instrument.admin factory AI.AllocationFactory_Allocate with
                settlement = poolSettlement operator poolId
                allocation = providerFunding provider instrument amount termEnd
                requestedAt
                inputHoldingCids = concatMap snd (TextMap.toList released.authorizerHoldingCids)
                extraArgs = allocateArgs
                actors = [provider]
        newA <- relock p.allocationA p.instrumentA p.amountA cancelArgsA factoryA allocateArgsA
        newB <- relock p.allocationB p.instrumentB p.amountB cancelArgsB factoryB allocateArgsB
        pure (newA, newB)

    choice RenewRequest_Cancel : ()
      controller provider
      do pure ()
