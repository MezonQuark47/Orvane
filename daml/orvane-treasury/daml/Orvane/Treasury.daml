-- | Private payroll on the Canton Network Token Standard (CIP-56).
--
-- 1. Each employee signs a PayeeConsent once: "my employer may pay me, and
--    the Orvane operator may convert my pay into the asset I prefer".
-- 2. Lock: the employer signs one command that allocates every line from
--    its treasury (sender employer, receiver employee, executor employer).
--    Each employee can see their own allocation, nobody else's.
-- 3. Release: one atomic transaction executes every allocation under the
--    consents, writes each payslip and an attestation for the auditor.
-- 4. Lines whose employee prefers another asset produce a ConvertTicket.
--    The operator converts through the Orvane exchange with the employee's
--    delegated authority. The operator never sees the rest of the payroll.
module Orvane.Treasury where

import DA.Action (foldlA)
import DA.Foldable (forA_)
import DA.Action (void, when)

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1

import Orvane.Exchange (ExchangeSwapOrder(..), ExchangeSwapOrder_Place(..), ExchangeSwapRequest)

-- ---------------------------------------------------------------- consent

template PayeeConsent
  with
    employee : Party
    employer : Party
    operator : Party
    receive  : InstrumentId   -- the asset this employee wants to end up with
  where
    signatory employee
    observer employer, operator

    -- | Used by PayrollBatch_Release: settle one locked line to this employee.
    nonconsuming choice PayeeConsent_ReceivePay : ContractId PayslipCn
      with
        allocationCid : ContractId Allocation
        extraArgs     : ExtraArgs
        runId         : Text
        period        : Text
      controller employer
      do
        v <- view <$> fetch allocationCid
        let leg = v.allocation.transferLeg
        assertMsg "allocation is not a payment from this employer to this employee"
          (leg.sender == employer && leg.receiver == employee && v.allocation.settlement.executor == employer)
        _ <- exercise allocationCid Allocation_ExecuteTransfer with extraArgs
        let convert = leg.instrumentId /= receive
        when convert $ void $
          create ConvertTicket with
            employee, operator, runId, from = leg.instrumentId, to = receive, amount = leg.amount
        create PayslipCn with
          employer, employee, runId, period
          paid = leg.amount, instrument = leg.instrumentId
          convertTo = if convert then Some receive else None

    choice PayeeConsent_Change : ContractId PayeeConsent
      with
        newReceive : InstrumentId
      controller employee
      do create this with receive = newReceive

    choice PayeeConsent_Revoke : ()
      controller employee
      do pure ()

-- | The employee's pay record. Signed by both, seen by both, nobody else.
template PayslipCn
  with
    employer   : Party
    employee   : Party
    runId      : Text
    period     : Text
    paid       : Decimal
    instrument : InstrumentId
    convertTo  : Optional InstrumentId
  where
    signatory employer, employee

-- | What the auditor sees: totals only.
template PayrollAttestationCn
  with
    employer   : Party
    auditors   : [Party]
    runId      : Text
    period     : Text
    headcount  : Int
    total      : Decimal
    instrument : InstrumentId
  where
    signatory employer
    observer auditors

-- ---------------------------------------------------------------- conversion

-- | A standing instruction, created at release, that lets the operator
-- swap this pay into the employee's preferred asset.
template ConvertTicket
  with
    employee : Party
    operator : Party
    runId    : Text
    from     : InstrumentId
    to       : InstrumentId
    amount   : Decimal
  where
    signatory employee
    observer operator

    -- | File an exchange swap for the employee, with their authority.
    choice ConvertTicket_Swap : ContractId ExchangeSwapRequest
      with
        poolId           : Text
        factoryCid       : ContractId AllocationFactory
        expectedAdmin    : Party
        allocation       : AllocationSpecification
        requestedAt      : Time
        inputHoldingCids : [ContractId Holding]
        extraArgs        : ExtraArgs
        minOut           : Decimal
      controller operator
      do
        let leg = allocation.transferLeg
        assertMsg "conversion must sell exactly this pay"
          (leg.sender == employee && leg.receiver == operator
            && leg.instrumentId == from && leg.amount == amount
            && allocation.settlement.executor == operator)
        order <- create ExchangeSwapOrder with
          trader = employee, operator, poolId, factoryCid, expectedAdmin, allocation
          requestedAt, inputHoldingCids, extraArgs, minOut
        exercise order ExchangeSwapOrder_Place

    choice ConvertTicket_Drop : ()
      with
        reason : Text
      controller operator
      do pure ()

-- ---------------------------------------------------------------- payroll run

data PayLineCn = PayLineCn
  with
    employee : Party
    amount   : Decimal
  deriving (Eq, Show)

data LockedPay = LockedPay
  with
    employee      : Party
    amount        : Decimal
    allocationCid : ContractId Allocation
  deriving (Eq, Show)

-- | One signature locks the whole payroll.
template PayrollOrderCn
  with
    employer         : Party
    auditors         : [Party]
    runId            : Text
    period           : Text
    factoryCid       : ContractId AllocationFactory
    instrument       : InstrumentId
    inputHoldingCids : [ContractId Holding]
    extraArgs        : ExtraArgs
    requestedAt      : Time
    allocateBefore   : Time
    settleBefore     : Time
    lines            : [PayLineCn]
  where
    signatory employer

    choice PayrollOrderCn_Lock : ContractId PayrollBatch
      controller employer
      do
        assertMsg "payroll has no lines" (not (null lines))
        assertMsg "every line needs a positive amount" (all (\l -> l.amount > 0.0) lines)
        let settlement = SettlementInfo with
              executor = employer
              settlementRef = Reference with id = runId; cid = None
              requestedAt, allocateBefore, settleBefore
              meta = emptyMetadata
            lockLine (acc, inputs, n) line = do
              res <- exercise factoryCid AllocationFactory_Allocate with
                expectedAdmin = instrument.admin
                allocation = AllocationSpecification with
                  settlement
                  transferLegId = "line-" <> show n
                  transferLeg = TransferLeg with
                    sender = employer, receiver = line.employee
                    amount = line.amount, instrumentId = instrument, meta = emptyMetadata
                requestedAt
                inputHoldingCids = inputs
                extraArgs
              cid <- case res.output of
                AllocationInstructionResult_Completed c -> pure c
                _ -> abort "the registry did not complete the allocation immediately"
              let lp = LockedPay with employee = line.employee; amount = line.amount; allocationCid = cid
              pure (lp :: acc, res.senderChangeCids, n + 1)
        (locked, _, _) <- foldlA lockLine ([], inputHoldingCids, 0 : Int) lines
        create PayrollBatch with employer, auditors, runId, period, instrument, locked = reverse locked

data Release = Release
  with
    consentCid : ContractId PayeeConsent
    extraArgs  : ExtraArgs
  deriving (Eq, Show)

-- | Locked payroll, waiting for payday. Visible to the employer only; each
-- employee sees their own allocation through the token standard.
template PayrollBatch
  with
    employer   : Party
    auditors   : [Party]
    runId      : Text
    period     : Text
    instrument : InstrumentId
    locked     : [LockedPay]
  where
    signatory employer

    -- | Pay everyone in one atomic transaction. `releases` lines up with `locked`.
    choice PayrollBatch_Release : ContractId PayrollAttestationCn
      with
        releases : [Release]
      controller employer
      do
        assertMsg "one release per locked line" (length releases == length locked)
        forA_ (zip locked releases) \(l, r) -> do
          consent <- fetch r.consentCid
          assertMsg "consent belongs to another employee"
            (consent.employee == l.employee && consent.employer == employer)
          exercise r.consentCid PayeeConsent_ReceivePay with
            allocationCid = l.allocationCid, extraArgs = r.extraArgs, runId, period
        create PayrollAttestationCn with
          employer, auditors, runId, period
          headcount = length locked
          total = sum (map (.amount) locked)
          instrument

    -- | Call off the run: the employer takes every allocation back.
    choice PayrollBatch_Cancel : ()
      with
        withdrawArgs : [ExtraArgs]
      controller employer
      do
        forA_ (zip locked withdrawArgs) \(l, a) ->
          exercise l.allocationCid Allocation_Withdraw with extraArgs = a
