-- | A ledger with two registries running Splice's official V2 test token,
-- one pool on top, and helpers that drive it the way the wallets and the
-- operator do.
module Test.Env where

import DA.Foldable (forA_)
import DA.List (sortOn)
import DA.TextMap qualified as TextMap
import DA.Date (Month(..), date)
import DA.Time

import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as H
import Splice.Api.Token.AllocationV2 qualified as A
import Splice.Api.Token.AllocationInstructionV2 qualified as AI

import Splice.Testing.Tokens.TestTokenV2 qualified as TT

import Orvane.Dex.Orders
import Orvane.Dex.Pool
import Orvane.Dex.State
import Orvane.Dex.Token

data Env = Env with
    operator : Party
    lp1 : Party
    lp2 : Party
    lp3 : Party
    trader : Party
    outsider : Party
    cc : H.InstrumentId
    usd : H.InstrumentId
    ccRules : ContractId TT.TokenRules
    usdRules : ContractId TT.TokenRules
    pool : ContractId PoolRules
    desk : ContractId OrderDesk
  deriving (Eq, Show)

thePool : Text
thePool = "cc-usd"

start : Time
start = time (date 2026 Nov 20) 12 0 0

-- | Pool terms used across the tests.
defaultRules : Party -> H.InstrumentId -> H.InstrumentId -> PoolRules
defaultRules operator cc usd = PoolRules with
  operator
  poolId = thePool
  instrumentA = cc
  instrumentB = usd
  feeBps = 30
  maxPositions = 3
  minTerm = days 1
  maxTerm = days 90
  ratioToleranceBps = 100

setup : Script Env
setup = setupWith defaultRules

setupWith : (Party -> H.InstrumentId -> H.InstrumentId -> PoolRules) -> Script Env
setupWith mkRules = do
  setTime start
  ccAdmin <- allocateParty "cc-admin"
  usdAdmin <- allocateParty "usd-admin"
  operator <- allocateParty "operator"
  lp1 <- allocateParty "lp1"
  lp2 <- allocateParty "lp2"
  lp3 <- allocateParty "lp3"
  trader <- allocateParty "trader"
  outsider <- allocateParty "outsider"
  let cc = H.InstrumentId with admin = ccAdmin; id = "TCC"
      usd = H.InstrumentId with admin = usdAdmin; id = "TUSD"
  ccRules <- submit ccAdmin $ createCmd TT.TokenRules with admin = ccAdmin
  usdRules <- submit usdAdmin $ createCmd TT.TokenRules with admin = usdAdmin
  pool <- submit operator $ createCmd (mkRules operator cc usd)
  (_, desk) <- submit operator $ exerciseCmd pool PoolRules_Open
  let env = Env with ..
  forA_ [lp1, lp2, lp3, trader] $ \p -> do
    mint env cc p 100000.0
    mint env usd p 100000.0
  pure env

-- Registry plumbing
--------------------

rulesFor : Env -> H.InstrumentId -> ContractId TT.TokenRules
rulesFor env i = if i == env.cc then env.ccRules else env.usdRules

-- | The choice context the test token wants: its rules contract, for
-- event logging.
ctx : Env -> H.InstrumentId -> ExtraArgs
ctx env i = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList [("testTokenV2/tokenRules", AV_ContractId (coerceContractId (rulesFor env i)))]
  meta = emptyMetadata

registry : Env -> H.InstrumentId -> Registry
registry env i = Registry with
  allocationFactory = toInterfaceContractId (rulesFor env i)
  settlementFactory = toInterfaceContractId (rulesFor env i)
  allocateArgs = ctx env i
  settleArgs = ctx env i

-- | What a registry API hands out: its rules and the funds locked in
-- allocations, so an executor can settle allocations whose locked funds it
-- cannot see. Read fresh before every submission, like a real client would.
disclosures : Env -> Script [Disclosure]
disclosures env = do
  ds <- forA [env.cc, env.usd] $ \i -> do
    let admin = i.admin
    rules <- queryDisclosure admin (rulesFor env i)
    tokens <- query @TT.Token admin
    tokenDs <- forA [ cid | (cid, t) <- tokens, t.holding.lock /= None ] (queryDisclosure admin)
    pure (rules :: tokenDs)
  pure [ d | Some d <- concat ds ]

-- What a wallet gets handed: the registry's disclosures plus the operator's
-- order desk, which the user is not a stakeholder of.
walletDisclosures : Env -> Script [Disclosure]
walletDisclosures env = do
  ds <- disclosures env
  desk <- queryDisclosure env.operator env.desk
  pure (ds <> optional [] pure desk)

mint : Env -> H.InstrumentId -> Party -> Decimal -> Script ()
mint _ i owner amount = do
  _ <- submit (actAs i.admin <> actAs owner) $ createCmd TT.Token with
    holding = H.HoldingView with
      account = basicAccount owner
      instrumentId = i
      amount
      lock = None
      meta = emptyMetadata
  pure ()

-- Balances
-----------

tokensOf : Party -> H.InstrumentId -> Script [(ContractId TT.Token, TT.Token)]
tokensOf p i = do
  ts <- query @TT.Token p
  pure [ t | t@(_, tok) <- ts, tok.holding.account == basicAccount p, tok.holding.instrumentId == i ]

-- | Unlocked funds a party can spend.
free : Party -> H.InstrumentId -> Script Decimal
free p i = do
  ts <- tokensOf p i
  pure (sum [ t.holding.amount | (_, t) <- ts, t.holding.lock == None ])

-- | Funds a party has locked in allocations.
locked : Party -> H.InstrumentId -> Script Decimal
locked p i = do
  ts <- tokensOf p i
  pure (sum [ t.holding.amount | (_, t) <- ts, t.holding.lock /= None ])

-- | Everything that exists of an instrument, as its admin sees it.
supply : H.InstrumentId -> Script Decimal
supply i = do
  ts <- query @TT.Token i.admin
  pure (sum [ t.holding.amount | (_, t) <- ts, t.holding.instrumentId == i ])

freeHoldings : Party -> H.InstrumentId -> Script [ContractId H.Holding]
freeHoldings p i = do
  ts <- tokensOf p i
  pure [ toInterfaceContractId cid | (cid, t) <- ts, t.holding.lock == None ]

-- Pool state
-------------

asOfNow : Script Time
asOfNow = do
  now <- getTime
  pure (addRelTime now (seconds (-1)))

poolState : Env -> Script (ContractId PoolState, PoolState)
poolState env = do
  states <- query @PoolState env.operator
  case states of
    [s] -> pure s
    _ -> fail ("expected exactly one pool state, got " <> show (length states))

positionsOf : Env -> Script [(ContractId LpPosition, LpPosition)]
positionsOf env = sortOn (\(_, p) -> p.positionId) <$> query @LpPosition env.operator

positionOf : Env -> Party -> Script (ContractId LpPosition, LpPosition)
positionOf env lp = do
  ps <- positionsOf env
  case [ x | x@(_, p) <- ps, p.provider == lp ] of
    [x] -> pure x
    _ -> fail "expected exactly one position for the provider"

-- Wallet side
--------------

placeDeposit : Env -> Party -> Text -> Decimal -> Decimal -> RelTime -> Script (ContractId DepositRequest)
placeDeposit env lp requestId amountA amountB term = do
  now <- getTime
  asOf <- asOfNow
  ds <- walletDisclosures env
  holdingsA <- freeHoldings lp env.cc
  holdingsB <- freeHoldings lp env.usd
  -- one exercise on the operator's desk: the only shape an external
  -- party's wallet can sign
  submit (actAs lp <> discloseMany ds) $ exerciseCmd env.desk
    OrderDesk_Deposit with
      provider = lp
      requestId
      instrumentA = env.cc
      amountA
      instrumentB = env.usd
      amountB
      termEnd = addRelTime now term
      factoryA = toInterfaceContractId env.ccRules
      holdingsA
      extraArgsA = ctx env env.cc
      factoryB = toInterfaceContractId env.usdRules
      holdingsB
      extraArgsB = ctx env env.usd
      requestedAt = asOf

placeSwap : Env -> Party -> Text -> H.InstrumentId -> Decimal -> Decimal -> Script (ContractId SwapRequest)
placeSwap env trader requestId instrumentIn amountIn minOut = do
  now <- getTime
  asOf <- asOfNow
  ds <- walletDisclosures env
  holdings <- freeHoldings trader instrumentIn
  let instrumentOut = if instrumentIn == env.cc then env.usd else env.cc
  submit (actAs trader <> discloseMany ds) $ exerciseCmd env.desk
    OrderDesk_Swap with
      trader
      requestId
      instrumentIn
      amountIn
      instrumentOut
      minOut
      deadline = addRelTime now (minutes 10)
      allocationFactory = toInterfaceContractId (rulesFor env instrumentIn)
      inputHoldingCids = holdings
      requestedAt = asOf
      extraArgs = ctx env instrumentIn

-- Operator side
----------------

addLiquidity : Env -> ContractId DepositRequest -> Script (ContractId LpPosition)
addLiquidity env req = do
  (stateCid, _) <- poolState env
  asOf <- asOfNow
  ds <- disclosures env
  (_, pos) <- submit (actAs env.operator <> discloseMany ds) $
    exerciseCmd env.pool PoolRules_AddLiquidity with stateCid; requestCid = req; asOf
  pure pos

swapCommand : Env -> ContractId SwapRequest -> Script (Commands SwapResult)
swapCommand env req = do
  (stateCid, _) <- poolState env
  positions <- positionsOf env
  asOf <- asOfNow
  r <- queryContractId env.operator req
  let instrumentIn = optional env.cc (.instrumentIn) r
      instrumentOut = if instrumentIn == env.cc then env.usd else env.cc
  pure $ exerciseCmd env.pool PoolRules_Swap with
    stateCid
    positionCids = map fst positions
    requestCid = req
    registryIn = registry env instrumentIn
    registryOut = registry env instrumentOut
    asOf

fill : Env -> ContractId SwapRequest -> Script SwapResult
fill env req = do
  cmd <- swapCommand env req
  ds <- disclosures env
  submit (actAs env.operator <> discloseMany ds) cmd

fillMustFail : Env -> ContractId SwapRequest -> Script ()
fillMustFail env req = do
  cmd <- swapCommand env req
  ds <- disclosures env
  submitMustFail (actAs env.operator <> discloseMany ds) cmd

-- | Place and fill a swap in one go.
swap : Env -> Party -> Text -> H.InstrumentId -> Decimal -> Script SwapResult
swap env trader requestId instrumentIn amountIn = do
  req <- placeSwap env trader requestId instrumentIn amountIn 0.0000000001
  fill env req

deposit : Env -> Party -> Text -> Decimal -> Decimal -> Script (ContractId LpPosition)
deposit env lp requestId amountA amountB = do
  req <- placeDeposit env lp requestId amountA amountB (days 30)
  addLiquidity env req

withdraw : Env -> Party -> Script (ContractId PoolState)
withdraw env lp = do
  (posCid, pos) <- positionOf env lp
  req <- submit lp $ createCmd WithdrawRequest with
    provider = lp
    operator = env.operator
    poolId = thePool
    positionId = pos.positionId
  (stateCid, _) <- poolState env
  asOf <- asOfNow
  ds <- disclosures env
  submit (actAs env.operator <> discloseMany ds) $
    exerciseCmd env.pool PoolRules_RemoveLiquidity with
      stateCid
      positionCid = posCid
      requestCid = req
      cancelArgsA = ctx env env.cc
      cancelArgsB = ctx env env.usd
      asOf

-- | The allocations a party can see, with their views.
allocationsOf : Party -> Script [(ContractId A.Allocation, A.AllocationView)]
allocationsOf p = do
  xs <- queryInterface @A.Allocation p
  pure [ (cid, v) | (cid, Some v) <- xs ]

factoryOf : Env -> H.InstrumentId -> ContractId AI.AllocationFactory
factoryOf env i = toInterfaceContractId (rulesFor env i)
